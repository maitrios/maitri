{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "maitri",
  "author": "maitri",
  "themes": [
    {
      "name": "maitri",
      "appearance": "{{ mode }}",
      "style": {
        "background": "{{ dark_background }}",
        "surface.background": "{{ dark_background }}",
        "elevated_surface.background": "{{ dark_background }}",
        "drop_target.background": "{{ mix dark_background accent 16% }}",

        "border": "{{ border }}",
        "border.variant": "{{ border }}",
        "border.focused": "{{ border_focus }}",
        "border.selected": "{{ border_focus }}",
        "border.transparent": "#00000000",
        "border.disabled": "{{ border }}",

        "element.background": "{{ mix dark_background lighter_background 50% }}",
        "element.hover": "{{ lighter_background }}",
        "element.active": "{{ mix dark_background accent 25% }}",
        "element.selected": "{{ mix dark_background accent 25% }}",
        "element.disabled": "{{ dark_background }}",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{ lighter_background }}",
        "ghost_element.active": "{{ mix dark_background accent 25% }}",
        "ghost_element.selected": "{{ mix dark_background accent 25% }}",
        "ghost_element.disabled": "#00000000",

        "text": "{{ foreground }}",
        "text.muted": "{{ light_foreground }}",
        "text.placeholder": "{{ comment }}",
        "text.disabled": "{{ comment }}",
        "text.accent": "{{ mix accent foreground 39% }}",
        "icon": "{{ foreground }}",
        "icon.muted": "{{ light_foreground }}",
        "icon.placeholder": "{{ comment }}",
        "icon.disabled": "{{ comment }}",
        "icon.accent": "{{ mix accent foreground 39% }}",
        "link_text.hover": "{{ link }}",

        "title_bar.background": "{{ dark_background }}",
        "title_bar.inactive_background": "{{ dark_background }}",
        "status_bar.background": "{{ dark_background }}",
        "toolbar.background": "{{ background }}",
        "tab_bar.background": "{{ dark_background }}",
        "tab.inactive_background": "{{ dark_background }}",
        "tab.active_background": "{{ background }}",
        "panel.background": "{{ dark_background }}",
        "panel.focused_border": "{{ border_focus }}",
        "panel.indent_guide": "{{ mix dark_background muted 75% }}",
        "panel.indent_guide_active": "{{ border_focus }}",
        "panel.indent_guide_hover": "{{ border }}",
        "pane.focused_border": "{{ border_focus }}",
        "pane_group.border": "{{ border }}",
        "search.match_background": "{{ mix background green 32% }}",

        "scrollbar.thumb.background": "{{ muted }}",
        "scrollbar.thumb.hover_background": "{{ border }}",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",

        "editor.foreground": "{{ foreground }}",
        "editor.background": "{{ background }}",
        "editor.gutter.background": "{{ background }}",
        "editor.subheader.background": "{{ dark_background }}",
        "editor.active_line.background": "{{ lighter_background }}",
        "editor.highlighted_line.background": "{{ lighter_background }}",
        "editor.line_number": "{{ comment }}",
        "editor.active_line_number": "{{ accent }}",
        "editor.invisible": "{{ mix background comment 55% }}",
        "editor.wrap_guide": "{{ mix background muted 75% }}",
        "editor.active_wrap_guide": "{{ border_focus }}",
        "editor.indent_guide": "{{ mix background muted 75% }}",
        "editor.indent_guide_active": "{{ border_focus }}",
        "editor.document_highlight.read_background": "{{ mix background accent 16% }}",
        "editor.document_highlight.write_background": "{{ mix background accent 16% }}",
        "editor.document_highlight.bracket_background": "{{ mix background accent 16% }}",

        "terminal.background": "{{ background }}",
        "terminal.foreground": "{{ foreground }}",
        "terminal.bright_foreground": "{{ bright_foreground }}",
        "terminal.dim_foreground": "{{ comment }}",
        "terminal.ansi.background": "{{ background }}",
        "terminal.ansi.black": "{{ background }}",
        "terminal.ansi.red": "{{ red }}",
        "terminal.ansi.green": "{{ green }}",
        "terminal.ansi.yellow": "{{ yellow }}",
        "terminal.ansi.blue": "{{ blue }}",
        "terminal.ansi.magenta": "{{ magenta }}",
        "terminal.ansi.cyan": "{{ cyan }}",
        "terminal.ansi.white": "{{ foreground }}",
        "terminal.ansi.bright_black": "{{ comment }}",
        "terminal.ansi.bright_red": "{{ bright_red }}",
        "terminal.ansi.bright_green": "{{ bright_green }}",
        "terminal.ansi.bright_yellow": "{{ bright_yellow }}",
        "terminal.ansi.bright_blue": "{{ bright_blue }}",
        "terminal.ansi.bright_magenta": "{{ bright_magenta }}",
        "terminal.ansi.bright_cyan": "{{ bright_cyan }}",
        "terminal.ansi.bright_white": "{{ bright_foreground }}",
        "terminal.ansi.dim_black": "{{ background }}",
        "terminal.ansi.dim_red": "{{ red }}",
        "terminal.ansi.dim_green": "{{ green }}",
        "terminal.ansi.dim_yellow": "{{ yellow }}",
        "terminal.ansi.dim_blue": "{{ blue }}",
        "terminal.ansi.dim_magenta": "{{ magenta }}",
        "terminal.ansi.dim_cyan": "{{ cyan }}",
        "terminal.ansi.dim_white": "{{ light_foreground }}",

        "error": "{{ red }}",
        "error.background": "{{ mix background red 10% }}",
        "error.border": "{{ red }}",
        "warning": "{{ orange }}",
        "warning.background": "{{ mix background orange 10% }}",
        "warning.border": "{{ orange }}",
        "info": "{{ cyan }}",
        "info.background": "{{ mix background cyan 10% }}",
        "info.border": "{{ cyan }}",
        "hint": "{{ hint }}",
        "hint.background": "{{ mix background hint 10% }}",
        "hint.border": "{{ hint }}",
        "success": "{{ green }}",
        "success.background": "{{ mix background green 10% }}",
        "success.border": "{{ green }}",
        "created": "{{ green }}",
        "created.background": "{{ mix background green 10% }}",
        "created.border": "{{ green }}",
        "modified": "{{ blue }}",
        "modified.background": "{{ mix background blue 10% }}",
        "modified.border": "{{ blue }}",
        "deleted": "{{ red }}",
        "deleted.background": "{{ mix background red 10% }}",
        "deleted.border": "{{ red }}",
        "conflict": "{{ orange }}",
        "conflict.background": "{{ mix background orange 10% }}",
        "conflict.border": "{{ orange }}",
        "renamed": "{{ cyan }}",
        "renamed.background": "{{ mix background cyan 10% }}",
        "renamed.border": "{{ cyan }}",
        "ignored": "{{ comment }}",
        "ignored.background": "{{ background }}",
        "ignored.border": "{{ border }}",
        "hidden": "{{ comment }}",
        "hidden.background": "{{ background }}",
        "hidden.border": "{{ border }}",
        "unreachable": "{{ comment }}",
        "unreachable.background": "{{ background }}",
        "unreachable.border": "{{ border }}",
        "predictive": "{{ comment }}",
        "predictive.background": "{{ background }}",
        "predictive.border": "{{ border }}",

        "version_control.added": "{{ green }}",
        "version_control.modified": "{{ blue }}",
        "version_control.deleted": "{{ red }}",
        "version_control.renamed": "{{ cyan }}",
        "version_control.conflict": "{{ orange }}",
        "version_control.ignored": "{{ comment }}",

        "players": [
          { "cursor": "{{ accent }}", "background": "{{ accent }}", "selection": "{{ selection }}" },
          { "cursor": "{{ cyan }}", "background": "{{ cyan }}", "selection": "{{ mix background cyan 25% }}" },
          { "cursor": "{{ green }}", "background": "{{ green }}", "selection": "{{ mix background green 25% }}" },
          { "cursor": "{{ orange }}", "background": "{{ orange }}", "selection": "{{ mix background orange 25% }}" },
          { "cursor": "{{ link }}", "background": "{{ link }}", "selection": "{{ mix background link 25% }}" },
          { "cursor": "{{ blue }}", "background": "{{ blue }}", "selection": "{{ mix background blue 25% }}" },
          { "cursor": "{{ yellow }}", "background": "{{ yellow }}", "selection": "{{ mix background yellow 25% }}" },
          { "cursor": "{{ red }}", "background": "{{ red }}", "selection": "{{ mix background red 25% }}" }
        ],

        "syntax": {
          "attribute": { "color": "{{ green }}", "font_style": "italic" },
          "boolean": { "color": "{{ blue }}" },
          "comment": { "color": "{{ comment }}", "font_style": "italic" },
          "comment.doc": { "color": "{{ comment }}", "font_style": "italic" },
          "constant": { "color": "{{ blue }}" },
          "constant.builtin": { "color": "{{ blue }}", "font_style": "italic" },
          "constructor": { "color": "{{ cyan }}" },
          "embedded": { "color": "{{ foreground }}" },
          "emphasis": { "color": "{{ foreground }}", "font_style": "italic" },
          "emphasis.strong": { "color": "{{ bright_foreground }}", "font_weight": 700 },
          "enum": { "color": "{{ cyan }}" },
          "function": { "color": "{{ green }}" },
          "function.builtin": { "color": "{{ cyan }}" },
          "hint": { "color": "{{ hint }}" },
          "keyword": { "color": "{{ magenta }}" },
          "label": { "color": "{{ blue }}", "font_style": "italic" },
          "link_text": { "color": "{{ link }}" },
          "link_uri": { "color": "{{ comment }}" },
          "module": { "color": "{{ cyan }}" },
          "namespace": { "color": "{{ cyan }}" },
          "number": { "color": "{{ blue }}" },
          "operator": { "color": "{{ magenta }}" },
          "predictive": { "color": "{{ comment }}", "font_style": "italic" },
          "preproc": { "color": "{{ magenta }}" },
          "primary": { "color": "{{ foreground }}" },
          "property": { "color": "{{ orange }}" },
          "punctuation": { "color": "{{ light_foreground }}" },
          "punctuation.bracket": { "color": "{{ light_foreground }}" },
          "punctuation.delimiter": { "color": "{{ light_foreground }}" },
          "punctuation.list_marker": { "color": "{{ accent }}" },
          "punctuation.markup": { "color": "{{ accent }}" },
          "punctuation.special": { "color": "{{ magenta }}" },
          "string": { "color": "{{ yellow }}" },
          "string.escape": { "color": "{{ magenta }}" },
          "string.regex": { "color": "{{ red }}" },
          "string.special": { "color": "{{ magenta }}" },
          "string.special.symbol": { "color": "{{ blue }}" },
          "tag": { "color": "{{ cyan }}" },
          "tag.attribute": { "color": "{{ green }}", "font_style": "italic" },
          "text.literal": { "color": "{{ cyan }}" },
          "title": { "color": "{{ accent }}", "font_weight": 700 },
          "type": { "color": "{{ cyan }}", "font_style": "italic" },
          "type.builtin": { "color": "{{ cyan }}", "font_style": "italic" },
          "variable": { "color": "{{ foreground }}" },
          "variable.member": { "color": "{{ orange }}" },
          "variable.parameter": { "color": "{{ orange }}", "font_style": "italic" },
          "variable.special": { "color": "{{ blue }}", "font_style": "italic" },
          "variant": { "color": "{{ blue }}" }
        }
      }
    }
  ]
}
