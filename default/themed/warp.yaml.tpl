# Warp terminal theme generated from the active maitri palette.
accent: '{{ accent }}'
background: '{{ background }}'
foreground: '{{ foreground }}'
details: darker
terminal_colors:
  normal:
    black: '{{ color0 }}'
    red: '{{ red }}'
    green: '{{ green }}'
    yellow: '{{ yellow }}'
    blue: '{{ blue }}'
    magenta: '{{ magenta }}'
    cyan: '{{ cyan }}'
    white: '{{ color7 }}'
  bright:
    black: '{{ muted }}'
    red: '{{ bright_red }}'
    green: '{{ bright_green }}'
    yellow: '{{ bright_yellow }}'
    blue: '{{ bright_blue }}'
    magenta: '{{ bright_magenta }}'
    cyan: '{{ bright_cyan }}'
    white: '{{ bright_foreground }}'
