# Warp terminal theme generated from the active maitri palette.
accent: '{{ accent }}'
background: '{{ background }}'
foreground: '{{ foreground }}'
details: {{ mode }}er
terminal_colors:
  normal:
    black: '{{ ansi_black }}'
    red: '{{ red }}'
    green: '{{ green }}'
    yellow: '{{ yellow }}'
    blue: '{{ blue }}'
    magenta: '{{ magenta }}'
    cyan: '{{ cyan }}'
    white: '{{ ansi_white }}'
  bright:
    black: '{{ ansi_bright_black }}'
    red: '{{ bright_red }}'
    green: '{{ bright_green }}'
    yellow: '{{ bright_yellow }}'
    blue: '{{ bright_blue }}'
    magenta: '{{ bright_magenta }}'
    cyan: '{{ bright_cyan }}'
    white: '{{ ansi_bright_white }}'
