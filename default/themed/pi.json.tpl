{
  "$schema": "https://pi.dev/schemas/theme.schema.json",
  "name": "maitri-system",
  "appearance": "{{ mode }}",
  "vars": {
    "background": "{{ background }}",
    "foreground": "{{ foreground }}",
    "accent": "{{ accent }}",
    "selectionBackground": "{{ selection_background }}",
    "selectionForeground": "{{ selection_foreground }}",
    "selectedBackground": "{{ mix background accent 22% }}",
    "color0": "{{ background }}",
    "color1": "{{ red }}",
    "color2": "{{ green }}",
    "color3": "{{ yellow }}",
    "color4": "{{ blue }}",
    "color5": "{{ magenta }}",
    "color6": "{{ cyan }}",
    "color7": "{{ foreground }}",
    "color8": "{{ comment }}",
    "color9": "{{ bright_red }}",
    "color10": "{{ bright_green }}",
    "color11": "{{ bright_yellow }}",
    "color12": "{{ bright_blue }}",
    "color13": "{{ bright_magenta }}",
    "color14": "{{ bright_cyan }}",
    "color15": "{{ bright_foreground }}",
    "orange": "{{ orange }}",
    "link": "{{ link }}",
    "panel": "{{ mix background foreground 6% }}",
    "panelAlt": "{{ mix background foreground 10% }}",
    "panelPending": "{{ mix background accent 8% }}",
    "panelSuccess": "{{ mix background green 8% }}",
    "panelError": "{{ mix background red 8% }}",
    "searchMatch": "{{ mix background green 32% }}",
    "border": "{{ border_focus }}",
    "borderMuted": "{{ border }}",
    "mutedText": "{{ light_foreground }}",
    "dimText": "{{ comment }}",
    "punctuation": "{{ light_foreground }}",
    "thinkingLow": "{{ mix border_focus accent 50% }}",
    "thinkingHigh": "{{ mix accent foreground 26% }}",
    "thinkingXhigh": "{{ mix accent foreground 52% }}"
  },
  "colors": {
    "accent": "accent",
    "border": "border",
    "borderAccent": "accent",
    "borderMuted": "borderMuted",
    "success": "color2",
    "error": "color1",
    "warning": "orange",
    "muted": "mutedText",
    "dim": "dimText",
    "text": "foreground",
    "thinkingText": "dimText",
    "selectedBg": "selectedBackground",
    "scrollbarTrack": "borderMuted",
    "scrollbarThumb": "dimText",
    "searchMatchBg": "searchMatch",
    "searchMatchText": "foreground",
    "userMessageBg": "panel",
    "userMessageText": "foreground",
    "customMessageBg": "panel",
    "customMessageText": "foreground",
    "customMessageLabel": "accent",
    "toolPendingBg": "panelPending",
    "toolSuccessBg": "panelSuccess",
    "toolErrorBg": "panelError",
    "toolTitle": "accent",
    "toolOutput": "foreground",
    "mdHeading": "accent",
    "mdLink": "link",
    "mdLinkUrl": "dimText",
    "mdCode": "color6",
    "mdCodeBlock": "foreground",
    "mdCodeBlockBorder": "borderMuted",
    "mdQuote": "mutedText",
    "mdQuoteBorder": "borderMuted",
    "mdHr": "borderMuted",
    "mdListBullet": "accent",
    "toolDiffAdded": "color2",
    "toolDiffRemoved": "color1",
    "toolDiffContext": "mutedText",
    "syntaxComment": "dimText",
    "syntaxKeyword": "color5",
    "syntaxFunction": "color2",
    "syntaxVariable": "foreground",
    "syntaxString": "color3",
    "syntaxNumber": "color4",
    "syntaxType": "color6",
    "syntaxOperator": "color5",
    "syntaxPunctuation": "punctuation",
    "thinkingOff": "borderMuted",
    "thinkingMinimal": "border",
    "thinkingLow": "thinkingLow",
    "thinkingMedium": "accent",
    "thinkingHigh": "thinkingHigh",
    "thinkingXhigh": "thinkingXhigh",
    "bashMode": "link"
  },
  "export": {
    "pageBg": "{{ background }}",
    "cardBg": "{{ mix background foreground 6% }}",
    "infoBg": "{{ mix background foreground 10% }}"
  }
}
