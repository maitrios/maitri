{
  "$schema": "https://opencode.ai/theme.json",
  "theme": {
    "primary": "{{ accent }}",
    "secondary": "{{ blue }}",
    "accent": "{{ hint }}",
    "error": "{{ red }}",
    "warning": "{{ orange }}",
    "success": "{{ green }}",
    "info": "{{ cyan }}",
    "text": "{{ foreground }}",
    "textMuted": "{{ comment }}",
    "selectedListItemText": "{{ background }}",
    "background": "none",
    "backgroundPanel": "{{ lighter_background }}",
    "backgroundElement": "{{ lighter_background }}",
    "backgroundMenu": "{{ lighter_background }}",
    "border": "{{ border }}",
    "borderActive": "{{ border_focus }}",
    "borderSubtle": "{{ mix background border 50% }}",
    "diffAdded": "{{ green }}",
    "diffRemoved": "{{ red }}",
    "diffContext": "{{ comment }}",
    "diffHunkHeader": "{{ cyan }}",
    "diffHighlightAdded": "{{ green }}",
    "diffHighlightRemoved": "{{ red }}",
    "diffAddedBg": "{{ mix background green 8% }}",
    "diffRemovedBg": "{{ mix background red 8% }}",
    "diffContextBg": "{{ background }}",
    "diffLineNumber": "{{ comment }}",
    "diffAddedLineNumberBg": "{{ mix background green 8% }}",
    "diffRemovedLineNumberBg": "{{ mix background red 8% }}",
    "markdownText": "{{ foreground }}",
    "markdownHeading": "{{ accent }}",
    "markdownLink": "{{ comment }}",
    "markdownLinkText": "{{ link }}",
    "markdownCode": "{{ cyan }}",
    "markdownBlockQuote": "{{ light_foreground }}",
    "markdownEmph": "{{ foreground }}",
    "markdownStrong": "{{ bright_foreground }}",
    "markdownHorizontalRule": "{{ border }}",
    "markdownListItem": "{{ accent }}",
    "markdownListEnumeration": "{{ accent }}",
    "markdownImage": "{{ comment }}",
    "markdownImageText": "{{ link }}",
    "markdownCodeBlock": "{{ foreground }}",
    "syntaxComment": "{{ comment }}",
    "syntaxKeyword": "{{ magenta }}",
    "syntaxFunction": "{{ green }}",
    "syntaxVariable": "{{ foreground }}",
    "syntaxString": "{{ yellow }}",
    "syntaxNumber": "{{ blue }}",
    "syntaxType": "{{ cyan }}",
    "syntaxOperator": "{{ magenta }}",
    "syntaxPunctuation": "{{ light_foreground }}"
  }
}
