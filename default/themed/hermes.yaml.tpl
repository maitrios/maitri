name: maitri
description: maitri system theme
colors:
  background: "{{ background }}"
  ui_text: "{{ foreground }}"
  ui_primary: "{{ accent }}"
  ui_accent: "{{ accent }}"
  ui_border: "{{ border }}"
  ui_label: "{{ mix accent foreground 26% }}"
  ui_ok: "{{ green }}"
  ui_warn: "{{ orange }}"
  ui_error: "{{ red }}"
  ui_tool: "{{ cyan }}"
  ui_thinking: "{{ comment }}"
  banner_border: "{{ border }}"
  banner_title: "{{ accent }}"
  banner_accent: "{{ mix accent foreground 13% }}"
  banner_dim: "{{ comment }}"
  banner_text: "{{ foreground }}"
  prompt: "{{ bright_foreground }}"
  input_rule: "{{ border }}"
  response_border: "{{ border_focus }}"
  shell_dollar: "{{ blue }}"
  selection_bg: "{{ selection }}"
  session_label: "{{ mix accent foreground 26% }}"
  session_border: "{{ border }}"
  status_bar_bg: "{{ dark_background }}"
  status_bar_text: "{{ foreground }}"
  status_bar_strong: "{{ accent }}"
  status_bar_dim: "{{ comment }}"
  status_bar_good: "{{ green }}"
  status_bar_warn: "{{ orange }}"
  status_bar_bad: "{{ red }}"
  status_bar_critical: "{{ mix red foreground 26% }}"
  voice_status_bg: "{{ dark_background }}"
  completion_menu_bg: "{{ dark_background }}"
  completion_menu_current_bg: "{{ mix dark_background accent 30% }}"
  completion_menu_meta_bg: "{{ dark_background }}"
  completion_menu_meta_current_bg: "{{ mix dark_background accent 30% }}"
  diff_added: "{{ mix background green 13% }}"
  diff_removed: "{{ mix background red 13% }}"
  diff_added_word: "{{ green }}"
  diff_removed_word: "{{ red }}"
  syntax_string: "{{ yellow }}"
  syntax_number: "{{ blue }}"
  syntax_keyword: "{{ magenta }}"
  syntax_comment: "{{ comment }}"
