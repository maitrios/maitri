{
  "name": "maitri",
  "appearance": "{{ mode }}",
  "canvas": "{{ background }}",
  "accent": "{{ accent }}",
  "colors": {
    "chrome": "{{ background }}",
    "toolbar": "{{ background }}",
    "toolbarForeground": "{{ foreground }}",
    "toolbarBorder": "{{ border }}",
    "toolbarControl": "{{ lighter_background }}",
    "toolbarControlForeground": "{{ foreground }}",
    "toolbarControlHover": "{{ mix lighter_background foreground 8% }}",

    "surface": "{{ dark_background }}",
    "surfaceRaised": "{{ dark_background }}",
    "surfaceOverlay": "{{ dark_background }}",
    "text": "{{ foreground }}",
    "textMuted": "{{ comment }}",
    "border": "{{ border }}",
    "input": "{{ border }}",
    "focus": "{{ border_focus }}",
    "accentForeground": "{{ background }}",
    "secondary": "{{ lighter_background }}",
    "secondaryForeground": "{{ foreground }}",
    "muted": "{{ lighter_background }}",
    "mutedForeground": "{{ comment }}",
    "placeholder": "{{ comment }}",
    "secondaryLabel": "{{ comment }}",
    "iconMuted": "{{ comment }}",

    "error": "{{ red }}",
    "errorForeground": "{{ red }}",
    "errorSurface": "{{ mix background red 13% }}",
    "warning": "{{ orange }}",
    "warningForeground": "{{ orange }}",
    "warningSurface": "{{ mix background orange 13% }}",
    "update": "{{ accent }}",
    "updateForeground": "{{ accent }}",
    "updateSurface": "{{ mix background accent 13% }}",

    "accentSurface": "{{ mix background foreground 8% }}",
    "accentSurfaceForeground": "{{ foreground }}",
    "messageSurface": "{{ mix background foreground 6% }}",
    "messageForeground": "{{ foreground }}",
    "messageAction": "{{ accent }}",
    "messageActionForeground": "{{ background }}",
    "messageActionHover": "{{ mix accent foreground 13% }}",

    "codeBackground": "{{ dark_background }}",
    "codeForeground": "{{ foreground }}",

    "searchMatchBackground": "{{ mix background green 32% }}",
    "searchMatchForeground": "{{ foreground }}",
    "searchMatchActiveBackground": "{{ orange }}",
    "searchMatchActiveForeground": "{{ background }}",

    "sidebar": "{{ background }}",
    "sidebarForeground": "{{ foreground }}",
    "sidebarMutedForeground": "{{ comment }}",
    "sidebarControlSurface": "{{ mix background foreground 6% }}",
    "sidebarBorder": "{{ border }}",
    "sidebarRowHover": "{{ mix background foreground 6% }}",
    "sidebarRowActive": "{{ mix background accent 6% }}",
    "sidebarRowSelected": "{{ mix background accent 10% }}",

    "terminalBackground": "{{ background }}",
    "terminalForeground": "{{ foreground }}",
    "terminalCursor": "{{ bright_foreground }}",
    "terminalSelection": "{{ selection }}",
    "terminalScrollbar": "{{ border }}",
    "terminalScrollbarHover": "{{ comment }}"
  }
}
