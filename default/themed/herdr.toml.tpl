[theme]
name = "terminal"
auto_switch = false

[theme.custom]
panel_bg = "{{ background }}"
sidebar_bg = "{{ dark_background }}"
surface0 = "{{ lighter_background }}"
surface1 = "{{ mix background foreground 6% }}"
surface_dim = "{{ border }}"
active_row_bg = "{{ lighter_background }}"
selection_bg = "{{ selection }}"
text = "{{ foreground }}"
subtext0 = "{{ light_foreground }}"
overlay0 = "{{ comment }}"
overlay1 = "{{ light_foreground }}"
accent = "{{ readable accent selection }}"
mauve = "{{ readable hint selection }}"
red = "{{ red }}"
green = "{{ green }}"
yellow = "{{ yellow }}"
blue = "{{ blue }}"
peach = "{{ orange }}"
teal = "{{ cyan }}"
