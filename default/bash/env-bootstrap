# Single source of truth for MAITRI_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/maitri.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-maitri          (Hyprland session via uwsm)
#   /usr/share/maitri/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/maitri.conf is written by maitri-dev-link and reset by
# maitri-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/maitri.conf ]; then
  . /etc/maitri.conf
  : "${MAITRI_PATH:=/usr/share/maitri}"
else
  MAITRI_PATH=/usr/share/maitri
fi
export MAITRI_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/maitri-* via the maitri package — prepending
# /usr/share/maitri/bin would just be noise.
if [ "$MAITRI_PATH" != /usr/share/maitri ]; then
  case ":$PATH:" in
    *":${MAITRI_PATH%/}/bin:"*) ;;
    *) PATH="${MAITRI_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
