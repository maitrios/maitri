# maitri environment (MAITRI_PATH + PATH), needed even for non-interactive shells
[[ -r /usr/share/maitri/default/bash/env-bootstrap ]] && source /usr/share/maitri/default/bash/env-bootstrap

# If not running interactively, don't do anything else (leave this above the rc source)
[[ $- != *i* ]] && return

# All the default maitri aliases and functions
# (don't mess with these directly, just overwrite them here!)
source "$MAITRI_PATH/default/bash/rc"

