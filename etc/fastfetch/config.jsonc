{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/maitri/branding/about.txt",
    "color": { "1": "magenta" },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "disableLinewrap": true,
    "color": { "keys": "magenta" }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "format": "{name}"
    },
    {
      "type": "display",
      "key": "│ ├󱄄"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊"
    },
    {
      "type": "memory",
      "key": "│ ├"
    },
    {
      "type": "swap",
      "key": "└ └󰓡 "
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "command",
      "key": "\ue900 OS",
      "text": "version=$(maitri-version) && echo \"maitri $version\""
    },
    {
      "type": "command",
      "key": "│ ├󰘬",
      "text": "maitri-version-branch"
    },
    {
      "type": "command",
      "key": "│ ├󰔫",
      "text": "channel=$(maitri-version-channel); echo \"$channel\""
    },
    {
      "type": "kernel",
      "key": "│ ├"
    },
    {
      "type": "wm",
      "key": "│ ├"
    },
    {
      "type": "de",
      "key": " DE"
    },
    {
      "type": "terminal",
      "key": "│ ├"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼"
    },
    {
      "type": "command",
      "key": "│ ├󰸌",
      "text": "theme=$(maitri-theme-current); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\""
    },
    {
      "type": "terminalfont",
      "key": "└ └"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Age / Uptime / Update───────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime"
    },
    {
      "type": "command",
      "key": " Update",
      "text": "updated=$(maitri-version-pkgs); echo \"$updated\""
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
