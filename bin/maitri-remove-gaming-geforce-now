#!/bin/bash

# maitri:summary=Remove the GeForce NOW Flatpak app and its data.
# maitri:group=remove
# maitri:name=gaming geforce-now

set -e

if maitri-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
