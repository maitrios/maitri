#!/bin/bash

# maitri:summary=Launch or attach to the persistent herdr session in a terminal

if maitri-cmd-present ghostty; then
  exec setsid uwsm-app -- ghostty --class=org.maitri.herdr --working-directory="$(maitri-cmd-terminal-cwd)" -e herdr
fi

exec maitri-launch-terminal --app-id=org.maitri.herdr -e herdr
