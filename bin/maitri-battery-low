#!/bin/bash

# maitri:summary=Send the low battery warning notification and run battery-low hooks.
# maitri:args=<percentage>
# maitri:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: maitri-battery-low <percentage>" >&2
  exit 1
fi

level=$1

maitri-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
maitri-hook battery-low "$level"
