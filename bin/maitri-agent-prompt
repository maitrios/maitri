#!/bin/bash

# maitri:summary=Launch the default coding agent with a prompt
# maitri:args=[--inline] <prompt...>
# maitri:examples=maitri agent prompt "Review this project"

# Prompts live here rather than on `maitri agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: maitri agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec maitri-agent "${inline[@]}" --prompt "$*"
