#!/bin/bash

# maitri:summary=Install the current maitri theme as an Insomnia theme plugin
# maitri:hidden=true

src="$HOME/.local/state/maitri/current/theme/insomnia-theme.json"
[[ -f $src ]] || exit 0

# The AppImage puts no command on PATH, so Insomnia also counts as present once
# it has created its config dir.
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/Insomnia"
maitri-cmd-present insomnia || [[ -d $config_dir ]] || exit 0

if grep -q '{{' "$src"; then
  echo "Skipping Insomnia theme: insomnia-theme.json has unresolved colors." >&2
  exit 0
fi

# The plugin is JavaScript Insomnia runs, so the theme only reaches index.js
# re-serialised by jq: a theme file that isn't plain JSON can't put code there.
# rawCss is dropped too, since Insomnia injects it as a stylesheet.
if ! theme=$(jq -ce '{name: "maitri", displayName: "maitri", theme: (.theme | objects | del(.rawCss))}' "$src" 2>/dev/null); then
  echo "Skipping Insomnia theme: insomnia-theme.json is not a theme object." >&2
  exit 0
fi

plugins_dir="$config_dir/plugins"
plugin_dir="$plugins_dir/insomnia-plugin-maitri"
mkdir -p "$plugin_dir"

cat >"$plugin_dir/package.json" <<'JSON'
{
  "name": "insomnia-plugin-maitri",
  "version": "1.0.0",
  "description": "The current maitri theme",
  "main": "index.js",
  "insomnia": {
    "name": "maitri",
    "description": "The current maitri theme"
  }
}
JSON

tmp=$(mktemp "$plugins_dir/.maitri-theme.XXXXXX")
printf 'module.exports.themes = [%s];\n' "$theme" >"$tmp"
mv "$tmp" "$plugin_dir/index.js"

# Insomnia keeps its settings in its own database, which maitri doesn't manage,
# so the theme is offered rather than selected.
echo "Insomnia picks up the maitri theme after a restart or Preferences > Plugins > Reload plugins; choose maitri under Preferences > Themes." >&2
