#!/bin/bash

# maitri:summary=Swap launcher icons for installed apps that have one in maitri's icon set

set -e

icon_dir="$MAITRI_PATH/default/icons"
state_dir="$HOME/.local/state/maitri/icons"
manifest="$state_dir/manifest"
originals_dir="$state_dir/originals"
copies="$state_dir/copies"
user_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
icon_theme_dir="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor"

variant_dirs=()
theme_name="$(cat "$HOME/.local/state/maitri/current/theme.name" 2>/dev/null || true)"
[[ $theme_name =~ ^[a-z0-9-]+$ ]] && variant_dirs+=("$icon_dir/$theme_name")
variant_dirs+=("$icon_dir")

system_dirs=()
IFS=: read -ra data_dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
for data_dir in "${data_dirs[@]}"; do
  system_dirs+=("$data_dir/applications")
done

if [[ ! -d $icon_dir ]]; then
  echo "No icon set at $icon_dir" >&2
  exit 1
fi

mkdir -p "$user_dir" "$originals_dir"
touch "$manifest"

tmp=""
trap '[[ -z $tmp ]] || rm -f "$tmp"' EXIT

entry_fields() {
  awk '
    /^\[/ { in_entry = ($0 == "[Desktop Entry]"); next }
    !in_entry { next }
    /^[ \t]*(NoDisplay|Hidden|Icon)[ \t]*=/ {
      name = $0; sub(/[ \t]*=.*/, "", name); sub(/^[ \t]*/, "", name)
      value = $0; sub(/^[^=]*=[ \t]*/, "", value); sub(/[ \t]+$/, "", value)
      if (name == "Icon") { if (icon == "") icon = value }
      else if (value == "true") hidden = 1
    }
    END { printf "%d\t%s\n", hidden, icon }
  ' "$1"
}

png_size() {
  local signature size

  signature="$(od -An -tx1 -N8 "$1" 2>/dev/null | tr -d ' \n')"
  [[ $signature == "89504e470d0a1a0a" ]] || return 1
  read -r size < <(od -An -tu1 -j16 -N8 "$1" 2>/dev/null | awk '{
    w = $1 * 16777216 + $2 * 65536 + $3 * 256 + $4
    h = $5 * 16777216 + $6 * 65536 + $7 * 256 + $8
    print (w == h ? w : "")
  }')
  [[ " 16 22 24 32 36 48 64 72 96 128 192 256 512 " == *" $size "* && -n $size ]] || return 1
  printf '%s\n' "$size"
}

icon_source() {
  local dir ext

  for dir in "${variant_dirs[@]}"; do
    for ext in png svg; do
      [[ -f $dir/$1.$ext ]] || continue
      [[ $ext == "svg" ]] || png_size "$dir/$1.$ext" >/dev/null || continue
      printf '%s\n' "$dir/$1.$ext"
      return 0
    done
  done
  return 1
}

icon_key() {
  local key="${1##*/}"

  [[ $key =~ \.(png|svg)$ ]] && key="${key%.*}"
  printf '%s\n' "${key#maitri-}"
}

icon_copy_path() {
  local source size

  source="$(icon_source "$1")" || return 1
  if [[ $source == *.svg ]]; then
    printf '%s\n' "$icon_theme_dir/scalable/apps/maitri-$1.svg"
  else
    size="$(png_size "$source")"
    printf '%s\n' "$icon_theme_dir/${size}x${size}/apps/maitri-$1.png"
  fi
}

icon_usable() {
  local copy

  icon_source "$1" >/dev/null || return 1
  copy="$(icon_copy_path "$1")"
  if [[ -e $copy || -L $copy ]] && ! grep -Fxqs "$copy" "$copies"; then
    echo "Not swapping $1: $copy is there and maitri didn't put it there" >&2
    return 1
  fi
}

ensure_icon() {
  local key source copy

  key="$(icon_key "$1")"
  source="$(icon_source "$key")" || return 0
  copy="$(icon_copy_path "$key")"
  if ! grep -Fxqs "$copy" "$copies"; then
    if [[ -e $copy || -L $copy ]]; then
      echo "Leaving $copy alone: maitri didn't put it there" >&2
      return 0
    fi
    printf '%s\n' "$copy" >>"$copies"
  fi
  if ! cmp -s "$source" "$copy"; then
    mkdir -p "${copy%/*}"
    tmp="$(mktemp "${copy%/*}/.maitri-icon.XXXXXX")"
    cp "$source" "$tmp"
    chmod 644 "$tmp"
    mv "$tmp" "$copy"
    tmp=""
    touch "$icon_theme_dir"
  fi
}

prune_icons() {
  local copy name kept=""

  [[ -f $copies ]] || return 0
  while IFS= read -r copy; do
    [[ -n $copy ]] || continue
    name="${copy##*/}"
    name="${name%.*}"
    if [[ -s $manifest ]] && cut -f3 "$manifest" | grep -Fxq "$name" && [[ $copy == "$(icon_copy_path "${name#maitri-}")" ]]; then
      kept+="$copy"$'\n'
    elif [[ -e $copy || -L $copy ]]; then
      rm -f "$copy"
      touch "$icon_theme_dir"
    fi
  done <"$copies"
  printf '%s' "$kept" >"$copies"
}

icon_for() {
  local hidden raw key

  IFS=$'\t' read -r hidden raw < <(entry_fields "$1")
  (( hidden == 0 )) || return 1
  [[ -n $raw && $raw != */* ]] || return 1

  key="$raw"
  [[ $key =~ \.(png|svg|xpm)$ ]] && key="${key%.*}"
  icon_usable "$key" || return 1
  printf '%s\t%s\n' "maitri-$key" "$raw"
}

render() {
  RAW="$3" ICON="$2" awk '
    /^[ \t]*Icon[ \t]*=/ {
      value = $0; sub(/^[^=]*=[ \t]*/, "", value); sub(/[ \t]+$/, "", value)
      if (value == ENVIRON["RAW"]) $0 = "Icon=" ENVIRON["ICON"]
    }
    { print }
  ' "$1"
}

file_hash() {
  sha256sum <"$1" | cut -d' ' -f1
}

write_override() {
  local source="$1" id="$2" icon="$3" raw="$4"

  tmp="$(mktemp "$state_dir/write.XXXXXX")"
  render "$source" "$icon" "$raw" >"$tmp"
  if [[ -f $user_dir/$id && ! -L $user_dir/$id ]] && cmp -s "$tmp" "$user_dir/$id"; then
    rm "$tmp"
  else
    chmod --reference="$source" "$tmp"
    mv "$tmp" "$user_dir/$id"
  fi
  tmp=""
}

swap_icon() {
  local file="$1" from="$2" to="$3"

  tmp="$(mktemp "$state_dir/write.XXXXXX")"
  FROM="Icon=$from" TO="Icon=$to" awk '$0 == ENVIRON["FROM"] { $0 = ENVIRON["TO"] } { print }' "$file" >"$tmp"
  chmod --reference="$file" "$tmp"
  mv "$tmp" "$file"
  tmp=""
}

revert_icon() {
  swap_icon "$1" "$2" "$(icon_key "$2")"
}

ids=()
declare -A kinds=() icons=() hashes=()

save_manifest() {
  local id

  tmp="$(mktemp "$state_dir/write.XXXXXX")"
  for id in "${ids[@]}"; do
    [[ -n ${kinds[$id]} ]] || continue
    printf '%s\t%s\t%s\t%s\n' "$id" "${kinds[$id]}" "${icons[$id]}" "${hashes[$id]}"
  done >"$tmp"
  mv "$tmp" "$manifest"
  tmp=""
}

record() {
  [[ -n ${kinds[$1]+set} ]] || ids+=("$1")
  kinds[$1]="$2"
  icons[$1]="$3"
  hashes[$1]="$4"
  save_manifest
}

forget() {
  kinds[$1]=""
  rm -f "$originals_dir/$1"
  save_manifest
}

while IFS=$'\t' read -r id kind icon hash; do
  [[ -n $id && -z ${kinds[$id]+set} ]] || continue
  ids+=("$id")
  kinds[$id]="$kind"
  icons[$id]="$icon"
  hashes[$id]="$hash"
done <"$manifest"

declare -A source=()
for dir in "${system_dirs[@]}"; do
  for desktop_file in "$dir"/*.desktop; do
    [[ -f $desktop_file ]] || continue
    id="${desktop_file##*/}"
    [[ -n ${source[$id]-} ]] || source[$id]="$desktop_file"
  done
done

declare -A seen=()
swapped=0

for id in "${ids[@]}"; do
  kind="${kinds[$id]}"
  icon="${icons[$id]}"
  hash="${hashes[$id]}"
  desktop_file="$user_dir/$id"

  fields=""
  if [[ $kind == "created" && -n ${source[$id]-} ]]; then
    fields="$(icon_for "${source[$id]}")" || fields=""
  fi
  new_icon="" raw=""
  [[ -z $fields ]] || IFS=$'\t' read -r new_icon raw <<<"$fields"

  if [[ ! -f $desktop_file ]]; then
    forget "$id"
    continue
  fi

  if ! grep -Fxq "Icon=$icon" "$desktop_file"; then
    if [[ -n $fields && -n $hash ]] && [[ $(render "$desktop_file" "$icon" "$raw" | sha256sum | cut -d' ' -f1) == "$hash" ]]; then
      ensure_icon "$new_icon"
      write_override "${source[$id]}" "$id" "$new_icon" "$raw"
      record "$id" "created" "$new_icon" "$(file_hash "$desktop_file")"
      seen[$id]=1
      echo "Swapped icon for $id"
      swapped=$((swapped + 1))
    else
      forget "$id"
    fi
    continue
  fi

  seen[$id]=1
  if [[ $kind != "created" ]]; then
    if ! icon_usable "$(icon_key "$icon")"; then
      if [[ -n $hash && $(file_hash "$desktop_file") == "$hash" ]] && [[ -e $originals_dir/$id || -L $originals_dir/$id ]]; then
        mv "$originals_dir/$id" "$desktop_file"
      else
        revert_icon "$desktop_file" "$icon"
      fi
      forget "$id"
      echo "Dropped icon override for $id"
      continue
    fi
    wanted="maitri-$(icon_key "$icon")"
    if [[ $icon != "$wanted" ]] && icon_usable "${wanted#maitri-}"; then
      ensure_icon "$wanted"
      unchanged=0
      [[ -n $hash && $(file_hash "$desktop_file") == "$hash" ]] && unchanged=1
      swap_icon "$desktop_file" "$icon" "$wanted"
      (( unchanged == 0 )) || hash="$(file_hash "$desktop_file")"
      record "$id" "$kind" "$wanted" "$hash"
    fi
    continue
  fi

  current="$(file_hash "$desktop_file")"
  if [[ -z $hash ]]; then
    hash="-"
    [[ -n $fields && $(render "${source[$id]}" "$icon" "$raw" | sha256sum | cut -d' ' -f1) == "$current" ]] && hash="$current"
  fi

  if [[ -z $fields ]]; then
    if [[ $current == "$hash" ]]; then
      rm "$desktop_file"
    else
      revert_icon "$desktop_file" "$icon"
    fi
    forget "$id"
    echo "Dropped icon override for $id"
    continue
  fi

  ensure_icon "$new_icon"
  if [[ $current == "$hash" ]]; then
    write_override "${source[$id]}" "$id" "$new_icon" "$raw"
    hash="$(file_hash "$desktop_file")"
    icon="$new_icon"
  elif [[ $icon != "$new_icon" ]]; then
    swap_icon "$desktop_file" "$icon" "$new_icon"
    icon="$new_icon"
  fi
  [[ $hash == "${hashes[$id]}" && $icon == "${icons[$id]}" ]] || record "$id" "created" "$icon" "$hash"
done

for dir in "$user_dir" "${system_dirs[@]}"; do
  for desktop_file in "$dir"/*.desktop; do
    [[ -f $desktop_file ]] || continue

    id="${desktop_file##*/}"
    [[ -z ${seen[$id]-} ]] || continue
    seen[$id]=1
    [[ -z ${kinds[$id]-} ]] || continue

    fields="$(icon_for "$desktop_file")" || continue
    IFS=$'\t' read -r icon raw <<<"$fields"

    if [[ $dir == "$user_dir" ]]; then
      cp -P "$desktop_file" "$originals_dir/$id"
      kind="replaced"
    else
      kind="created"
    fi

    ensure_icon "$icon"
    write_override "$desktop_file" "$id" "$icon" "$raw"
    record "$id" "$kind" "$icon" "$(file_hash "$user_dir/$id")"
    echo "Swapped icon for $id"
    swapped=$((swapped + 1))
  done
done

if [[ -s $manifest ]]; then
  while IFS=$'\t' read -r _ _ icon _; do
    [[ $icon != maitri-* ]] || ensure_icon "$icon"
  done <"$manifest"
fi
prune_icons

if [[ ! -s $manifest ]]; then
  rm -rf "$state_dir"
  update-desktop-database "$user_dir" &>/dev/null || true
  echo "No installed apps have an icon in maitri's set"
  exit 0
fi

update-desktop-database "$user_dir" &>/dev/null || true

(( swapped > 0 )) || echo "maitri icons are already in place"
