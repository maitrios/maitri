#!/bin/bash

# maitri:summary=Remove a supported browser and clean up maitri browser defaults
# maitri:args=<chromium|chrome|brave|brave-origin|edge|firefox|zen>
# maitri:examples=maitri remove browser firefox | maitri remove browser brave
# maitri:requires-sudo=true

set_fallback_default_browser() {
  local current_browser
  current_browser=$(env -u BROWSER xdg-settings get default-web-browser)

  if [[ $current_browser != $1 ]]; then
    return
  fi

  if maitri-cmd-present helium; then
    env -u BROWSER xdg-settings set default-web-browser helium.desktop || true
  fi
}

case $1 in
chromium)
  echo "Removing Chromium..."
  set_fallback_default_browser chromium.desktop
  maitri-pkg-drop chromium
  rm -f ~/.config/chromium-flags.conf
  ;;
chrome)
  echo "Removing Chrome..."
  set_fallback_default_browser google-chrome.desktop
  maitri-pkg-drop google-chrome
  rm -f ~/.config/chrome-flags.conf
  ;;
edge)
  echo "Removing Edge..."
  set_fallback_default_browser microsoft-edge.desktop
  maitri-pkg-drop microsoft-edge-stable-bin
  rm -f ~/.config/microsoft-edge-stable-flags.conf
  ;;
brave)
  echo "Removing Brave..."
  set_fallback_default_browser brave-browser.desktop
  maitri-pkg-drop brave-bin
  rm -f ~/.config/brave-flags.conf

  if maitri-pkg-missing brave-origin-bin; then
    sudo rm -rf /etc/brave
  fi
  ;;
brave-origin)
  echo "Removing Brave Origin..."
  set_fallback_default_browser brave-origin.desktop
  maitri-pkg-drop brave-origin-bin
  rm -f ~/.config/brave-origin-flags.conf

  if maitri-pkg-missing brave-bin; then
    sudo rm -rf /etc/brave
  fi
  ;;
firefox)
  echo "Removing Firefox..."
  set_fallback_default_browser firefox.desktop
  maitri-pkg-drop firefox
  ;;
zen)
  echo "Removing Zen..."
  set_fallback_default_browser zen.desktop
  maitri-pkg-drop zen-browser-bin
  ;;
*)
  echo "Usage: maitri-remove-browser <chromium|chrome|brave|brave-origin|edge|firefox|zen>"
  exit 1
  ;;
esac
