#!/bin/bash

# maitri:summary=Shut down after closing application windows
# maitri:examples=maitri shutdown | maitri system shutdown
# maitri:aliases=maitri shutdown

if [[ ${1:-} == "--inhibited" ]]; then
  # Close windows in the background so they cannot delay power-off.
  (
    maitri-osd -i shutdown -m "Shutting down" -d 5000
    maitri-state clear re*-required
    maitri-hyprland-window-close-all
  ) &

  sleep 2 # Allow apps like Chrome to shut down correctly
  systemctl poweroff --no-wall
elif [[ ${1:-} == "--inhibit" ]]; then
  # Report failures from inside the service, independently of the launching terminal.
  # Block lid handling explicitly: it ignores high-level sleep inhibitors.
  systemd-inhibit --what=sleep:idle:handle-lid-switch \
    --who=maitri --why="Shutdown in progress" --mode=block \
    "$0" --inhibited || {
    status=$?
    maitri-notification-send -u critical "Shutdown failed" "Could not complete shutdown. Please try again."
    exit "$status"
  }
else
  # Schedule the shutdown in the user manager so closing the terminal's systemd
  # scope cannot terminate it before it runs.
  systemd-run --user --collect --quiet --property=Type=exec --property=RuntimeMaxSec=30s \
    "$MAITRI_PATH/bin/maitri-system-shutdown" --inhibit
fi
