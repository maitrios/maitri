#!/bin/bash

# maitri:summary=Update maitri and system packages
# maitri:args=[-y]
# maitri:examples=maitri update | maitri update -y
# maitri:requires-sudo=true

set -e

if [[ -z ${MAITRI_UPDATE_LOGGED:-} ]]; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env MAITRI_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/maitri-update.log"
fi

if ! maitri-update-lock held; then
  exec maitri-update-lock run "$0" "$@"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, report it at https://github.com/maitrios/maitri/issues\033[0m"' ERR
trap 'maitri-update-stay-awake stop' EXIT

maitri-update-requires-free-space

# -y is a promise not to ask anything. Steps that would need an answer report
# and move on instead of waiting on a prompt nobody is here to give.
[[ ${1:-} != "-y" ]] || export MAITRI_UPDATE_UNATTENDED=1

if [[ ${1:-} == "-y" ]] || maitri-update-confirm; then
  # Before the snapshot: the cache is on the snapshotted subvolume, so pruning
  # after it frees nothing until that snapshot ages out.
  maitri-update-pkg-prune

  # 127 means Snapper is deliberately absent. Any other failure already said
  # what went wrong, and a missing snapshot is not worth blocking an update
  # over, but it must not pass for one either.
  maitri-snapshot create || (($? == 127)) ||
    echo -e "\e[33mContinuing the update without a snapshot.\e[0m" >&2

  maitri-update-stay-awake start

  maitri-update-dev
  maitri-update-keyring

  # Migrations ship with the packages installed here and are written against
  # them, so everything below waits on this finishing. An upgrade that stopped
  # takes the update with it rather than migrating against what is still on disk.
  maitri-update-system-pkgs
  maitri-migrate
  maitri-hook post-update
  maitri-update-aur-pkgs
  maitri-update-mise
  maitri-update-orphan-pkgs

  maitri-update-analyze-logs
  maitri-update-status

  # Release update-owned inhibitors before offering a reboot. A confirmed
  # reboot can terminate this process before its EXIT trap gets a chance to
  # remove the persistent Stay Awake marker.
  maitri-update-stay-awake stop
  trap - EXIT

  maitri-update-restart
fi
