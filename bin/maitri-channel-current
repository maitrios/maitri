#!/bin/bash

# maitri:summary=Print the active maitri package channel

set -euo pipefail

# Dev is a linked source checkout: MAITRI_PATH points somewhere other than
# the package-backed install at /usr/share/maitri. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $MAITRI_PATH != "/usr/share/maitri" ]]; then
  echo dev
  exit 0
fi

# maitri-dev / maitri-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. maitri / maitri-settings come
# from the stable repo; maitri-version-channel confirms which [maitri] repo
# pacman.conf points at.
if pacman -Q maitri-dev maitri-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q maitri maitri-settings >/dev/null 2>&1; then
  channel=$(maitri-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
