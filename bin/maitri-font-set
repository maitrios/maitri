#!/bin/bash

# maitri:summary=Set the system monospace font
# maitri:args=<font-name>
# maitri:examples=maitri font list | maitri font set "CaskaydiaMono Nerd Font"

usage() {
  echo "Usage: maitri-font-set <font-name>"
}

font_name="${1:-}"

case "$font_name" in
  -h|--help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 1
    ;;
esac

if ! fc-list | grep -Fqi -- "$font_name"; then
  echo "Font '$font_name' not found."
  exit 1
fi

if [[ -f ~/.config/alacritty/alacritty.toml ]]; then
  sed -i "s/family = \".*\"/family = \"$font_name\"/g" ~/.config/alacritty/alacritty.toml
fi

if [[ -f ~/.config/kitty/kitty.conf ]] || maitri-cmd-present kitty; then
  mkdir -p ~/.config/kitty
  if grep -qE '^[[:space:]]*font_family[[:space:]]+' ~/.config/kitty/kitty.conf 2>/dev/null; then
    kitty_font_name=$(printf '%s' "$font_name" | sed 's/[\\&/]/\\&/g')
    sed --follow-symlinks -i -E "s/^[[:space:]]*font_family[[:space:]]+.*/font_family $kitty_font_name/" ~/.config/kitty/kitty.conf
  else
    printf '\nfont_family %s\n' "$font_name" >>~/.config/kitty/kitty.conf
  fi
  pkill -USR1 kitty
fi

if [[ -f ~/.config/ghostty/config ]]; then
  sed -i "s/font-family = \".*\"/font-family = \"$font_name\"/g" ~/.config/ghostty/config
  pkill -SIGUSR2 ghostty
fi

if [[ -f ~/.config/foot/foot.ini ]]; then
  sed -i "s/^font=.*/font=$font_name:size=9/g" ~/.config/foot/foot.ini
fi

vscode_font_py=$(cat <<'PY'
import json, os, re, sys, tempfile

path, font = sys.argv[1:3]
real = os.path.realpath(path)
with open(real, encoding="utf-8") as f:
    original = f.read()
text = original if original.strip() else "{}\n"

def invalid():
    print(f"Leaving {path} as is: it isn't valid JSON.", file=sys.stderr)
    sys.exit(0)

def string_end(s, i):
    j = i + 1
    while j < len(s) and s[j] != '"':
        j += 2 if s[j] == "\\" else 1
    return j + 1

parts, i = [], 0
while i < len(text):
    if text[i] == '"':
        j = string_end(text, i)
        parts.append(text[i:j])
    elif text.startswith("//", i):
        j = text.find("\n", i)
        j = len(text) if j < 0 else j
        parts.append(" " * (j - i))
    elif text.startswith("/*", i):
        j = text.find("*/", i + 2)
        if j < 0:
            invalid()
        j += 2
        parts.append(re.sub(r"[^\n]", " ", text[i:j]))
    else:
        j = i + 1
        parts.append(text[i])
    i = j
plain = "".join(parts)

parts, i = [], 0
while i < len(plain):
    if plain[i] == '"':
        j = string_end(plain, i)
        parts.append(plain[i:j])
        i = j
        continue
    trailing = plain[i] == "," and re.match(r"\s*[}\]]", plain[i + 1:])
    parts.append(" " if trailing else plain[i])
    i += 1
plain = "".join(parts)

try:
    root = json.loads(plain)
except ValueError:
    invalid()
if not isinstance(root, dict):
    invalid()

ws = re.compile(r"\s*")
decoder = json.JSONDecoder()
brace = ws.match(plain).end()
spans = {}
pos = brace + 1
while True:
    pos = ws.match(plain, pos).end()
    if plain[pos] == "}":
        break
    key, pos = json.decoder.scanstring(plain, pos + 1)
    pos = ws.match(plain, ws.match(plain, pos).end() + 1).end()
    _, end = decoder.raw_decode(plain, pos)
    spans.setdefault(key, []).append((pos, end))
    pos = ws.match(plain, end).end()
    if plain[pos] == ",":
        pos += 1

def css(name):
    return "'" + name.replace("\\", "\\\\").replace("'", "\\'") + "'"

values = {
    "editor.fontFamily": f"{css(font)}, 'monospace'",
    "terminal.integrated.fontFamily": css(font),
}
edits, missing = [], []
for key, value in values.items():
    encoded = json.dumps(value, ensure_ascii=False)
    if key in spans:
        edits += [(start, end, encoded) for start, end in spans[key]]
    else:
        missing.append(f"\n  {json.dumps(key)}: {encoded}")
if missing:
    edits.append((brace + 1, brace + 1, ",".join(missing) + ("," if root else "\n")))

updated = text
for start, end, replacement in sorted(edits, reverse=True):
    updated = updated[:start] + replacement + updated[end:]
if updated == original:
    sys.exit(0)

fd, tmp = tempfile.mkstemp(dir=os.path.dirname(real), prefix=".settings.json.")
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(updated)
    os.chmod(tmp, os.stat(real).st_mode & 0o7777)
    os.replace(tmp, real)
except BaseException:
    os.unlink(tmp)
    raise
PY
)

if [[ -f ~/.config/Code/User/settings.json ]]; then
  python3 -I -c "$vscode_font_py" ~/.config/Code/User/settings.json "$font_name"
fi

# fontconfig is the canonical source of truth — the maitri shell, Qt apps,
# and anything resolving "monospace" all read from here. This file is loaded
# after the package-owned default, and prepend_first puts the chosen family at
# the head of the list so it wins over the family that default prefers.
fontconfig_file="$HOME/.config/fontconfig/fonts.conf"
mkdir -p "$(dirname "$fontconfig_file")"
cat >"$fontconfig_file" <<XML
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any">
      <string>monospace</string>
    </test>
    <edit name="family" mode="prepend_first" binding="strong">
      <string>$font_name</string>
    </edit>
  </match>
</fontconfig>
XML

maitri-restart-shell

if pgrep -x ghostty; then
  maitri-notification-send -g  "You must restart Ghostty to see font change"
fi

if pgrep -x foot; then
  maitri-notification-send -g  "You must restart Foot to see font change"
fi

maitri-hook font-set "$font_name"
