#!/bin/bash

# maitri:summary=Launch a TUI or focus an existing terminal window for it
# maitri:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.maitri.$(basename "$1")"
fi

LAUNCH_COMMAND="maitri-launch-tui $@"

exec maitri-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
