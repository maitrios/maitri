#!/bin/bash

# maitri:summary=Apply maitri system setup in the installed target
# maitri:group=apply
# maitri:requires-sudo=true
# maitri:examples=maitri apply system --install-user dhh --first-install
# maitri:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: maitri apply system --install-user USER [--first-install|--upgrade]
       maitri apply system --defer-provisioning --first-install

Runs root-owned maitri system setup. The ISO calls this in the target chroot
after packages are installed and the target user exists. It also calls
maitri-apply-hardware, so hardware setup cannot be accidentally skipped.

--defer-provisioning runs without an install user: deferred-provisioning installs create the user at
first boot, so scripts that grant group memberships record them in
/var/lib/maitri/provisioning/groups instead of calling usermod.
USAGE
}

install_user="${MAITRI_INSTALL_USER:-}"
first_install=0
upgrade=0
defer_provisioning=0

while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    --first-install)
      first_install=1
      shift
      ;;
    --upgrade)
      upgrade=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: maitri-apply-system must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export MAITRI_INSTALL_USER="$install_user"
export MAITRI_FIRST_INSTALL="$first_install"
export MAITRI_UPGRADE="$upgrade"
export MAITRI_PATH="${MAITRI_PATH:-/usr/share/maitri}"
export MAITRI_INSTALL="${MAITRI_INSTALL:-$MAITRI_PATH/install}"
export MAITRI_INSTALL_LOG_FILE="${MAITRI_INSTALL_LOG_FILE:-/var/log/maitri-install.log}"
export PATH="$MAITRI_PATH/bin:$PATH"

source "$MAITRI_INSTALL/helpers/logging.sh"
start_install_log

source "$MAITRI_INSTALL/config/all.sh"

if (( defer_provisioning )); then
  maitri-apply-hardware --defer-provisioning
else
  maitri-apply-hardware --install-user "$install_user"
fi

source "$MAITRI_INSTALL/login/all.sh"
source "$MAITRI_INSTALL/post-install/all.sh"

stop_install_log
