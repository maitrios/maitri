#!/bin/bash

# maitri:summary=Ensure the maitri and Arch keyring packages are installed and populated
# maitri:requires-sudo=true

MAITRI_KEY_FINGERPRINT=B15B4ED7BC9470F1710484ABB9562AC7D0D9EA1F
MAITRI_KEY_URL=https://raw.githubusercontent.com/maitrios/maitri-pkgs/main/pkgbuilds/maitri-keyring/maitri.gpg

maitri_key_trusted() {
  sudo pacman-key --list-sigs "$MAITRI_KEY_FINGERPRINT" 2>/dev/null | grep -q '^sig L '
}

# A key that is in the keyring but was never locally signed (only its self
# signature) is untrusted, so check the local signature, not just presence.
if maitri-pkg-missing maitri-keyring || ! maitri_key_trusted; then
  # The signing key is not on a keyserver. Bootstrap trust from the keyring
  # package's own copy when it is on disk, otherwise from the maitri-pkgs repo,
  # so the [maitri] database and the keyring package itself can be verified.
  if [[ -f /usr/share/pacman/keyrings/maitri.gpg ]]; then
    sudo pacman-key --populate maitri
  elif ! sudo pacman-key --list-keys "$MAITRI_KEY_FINGERPRINT" &>/dev/null; then
    keyfile=$(mktemp)
    curl -fsSL "$MAITRI_KEY_URL" -o "$keyfile"
    sudo pacman-key --add "$keyfile"
    rm -f "$keyfile"
  fi
  sudo pacman-key --lsign-key "$MAITRI_KEY_FINGERPRINT"

  # This is generally not a good idea, but this is a special case because we're going to be updating
  # the full set of packages in maitri-update-system-pkgs right after this (and it needs latest keyring)!
  sudo pacman -Sy
  maitri-pkg-add maitri-keyring

  sudo pacman-key --list-keys "$MAITRI_KEY_FINGERPRINT"
fi

# Ensure we have the latest archlinux-keyring, maintainer keys might have changed.
# --needed installs only a newer keyring: new or revoked keys reach the repos
# as a new package version, and an installed version was populated when it
# went in, so reinstalling the same one only repeats that populate.
echo -e "\e[32m\nUpdate Arch signing keys\e[0m"
sudo pacman -Sy --needed --noconfirm archlinux-keyring >/dev/null 2> >(grep -vE '^warning: archlinux-keyring-[^ ]+ is up to date -- skipping$' >&2)
echo "Keys are correct"
