#!/bin/bash

# maitri:summary=Run the maitri screensaver using random effects from TTE.

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.maitri.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  pkill -x ttfx 2>/dev/null
  pkill -f '[o]rg.maitri.screensaver' 2>/dev/null
  rm -rf "$frame_dir"
  exit 0
}

# Exit the screensaver on signals and input from keyboard and mouse
trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'  # Set background color to black

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

# Terminals allocate the pty at the default 80x24 and only resize it once the
# compositor has told the window how big it is. ttfx measures the terminal once,
# at startup, so starting it before the resize lands sizes an 80x24 canvas and
# paints it into the corner of a fullscreen window.
wait_for_terminal_resize() {
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
    sleep 0.02
  done
}

wait_for_terminal_resize

# A line holding only a form feed splits screensaver.txt into frames, and each
# effect shows the next one that has something to draw, so the heart and the
# wordmark take turns.
text=~/.config/maitri/branding/screensaver.txt
frame_dir=$(mktemp -d)
frame=0

while true; do
  awk -v want="$frame" '
    { sub(/\r$/, "") }
    function keep() { if (buf ~ /[^[:space:]]/) frames[n++] = buf; buf = "" }
    $0 == "\f" { keep(); next }
    { buf = buf $0 "\n" }
    END { keep(); if (n) printf "%s", frames[want % n] }
  ' "$text" >"$frame_dir/next" 2>/dev/null

  # ttfx exits at once on empty input, which would respawn it in a tight loop
  # that never reaches the input and focus checks below.
  if [[ ! -s $frame_dir/next ]]; then
    maitri-notification-send -g 󱄄 "Screensaver has nothing to show" "Restore the default under Style > Screensaver"
    exit_screensaver
  fi

  mv "$frame_dir/next" "$frame_dir/frame"
  frame=$((frame + 1))

  ttfx -i "$frame_dir/frame" \
    --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c\
    --random-effect --no-eol --no-restore-cursor &
  effect=$!

  while kill -0 "$effect" 2>/dev/null; do
    if read -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
done
