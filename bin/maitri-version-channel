#!/bin/bash

# maitri:summary=Print the active maitri package channel

# Arch packages always come from the official mirrors, so the channel is
# decided by which [maitri] repository pacman.conf points at: a GitHub
# Release per channel on maitrios/maitri-pkgs.
if grep -q "maitrios/maitri-pkgs/releases/download/stable" /etc/pacman.conf; then
  echo stable
elif grep -q "maitrios/maitri-pkgs/releases/download/edge" /etc/pacman.conf; then
  echo edge
else
  echo unknown
fi
