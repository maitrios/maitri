#!/bin/bash

# maitri:summary=Set or remove top-level string settings in a VS Code settings.json
# maitri:args=<settings.json> [--set <key> <value> | --unset <key>]...
# maitri:hidden=true

usage() {
  echo "Usage: maitri-vscode-settings-set <settings.json> [--set <key> <value> | --unset <key>]..."
}

if [[ $1 == "-h" || $1 == "--help" ]]; then
  usage
  exit 0
fi

if (( $# < 1 )) || [[ ! -f $1 ]]; then
  usage >&2
  exit 1
fi

settings_py=$(cat <<'PY'
import json, os, re, sys, tempfile

path, *args = sys.argv[1:]
sets, unsets = {}, set()
while args:
    if args[0] == "--set" and len(args) >= 3:
        sets[args[1]] = args[2]
        args = args[3:]
    elif args[0] == "--unset" and len(args) >= 2:
        unsets.add(args[1])
        args = args[2:]
    else:
        print("Usage: maitri-vscode-settings-set <settings.json> [--set <key> <value> | --unset <key>]...", file=sys.stderr)
        sys.exit(1)

real = os.path.realpath(path)
with open(real, encoding="utf-8") as f:
    original = f.read()
text = original if original.strip() else "{}\n"

def invalid():
    print(f"Leaving {path} as is: it isn't valid JSON.", file=sys.stderr)
    sys.exit(0)

def string_end(s, i):
    j = i + 1
    while j < len(s) and s[j] != '"':
        j += 2 if s[j] == "\\" else 1
    return j + 1

parts, i = [], 0
while i < len(text):
    if text[i] == '"':
        j = string_end(text, i)
        parts.append(text[i:j])
    elif text.startswith("//", i):
        j = text.find("\n", i)
        j = len(text) if j < 0 else j
        parts.append(" " * (j - i))
    elif text.startswith("/*", i):
        j = text.find("*/", i + 2)
        if j < 0:
            invalid()
        j += 2
        parts.append(re.sub(r"[^\n]", " ", text[i:j]))
    else:
        j = i + 1
        parts.append(text[i])
    i = j
plain = "".join(parts)

parts, i = [], 0
while i < len(plain):
    if plain[i] == '"':
        j = string_end(plain, i)
        parts.append(plain[i:j])
        i = j
        continue
    trailing = plain[i] == "," and re.match(r"\s*[}\]]", plain[i + 1:])
    parts.append(" " if trailing else plain[i])
    i += 1
plain = "".join(parts)

try:
    root = json.loads(plain)
except ValueError:
    invalid()
if not isinstance(root, dict):
    invalid()

ws = re.compile(r"\s*")
decoder = json.JSONDecoder()
brace = ws.match(plain).end()
members = []
pos = brace + 1
while True:
    pos = ws.match(plain, pos).end()
    if plain[pos] == "}":
        break
    key_start = pos
    key, pos = json.decoder.scanstring(plain, pos + 1)
    pos = ws.match(plain, ws.match(plain, pos).end() + 1).end()
    _, end = decoder.raw_decode(plain, pos)
    after = ws.match(plain, end).end()
    comma = plain[after] == ","
    members.append((key, key_start, pos, end, after + 1 if comma else None))
    pos = after + 1 if comma else after

edits, removals, present = [], [], set()
for index, (key, key_start, start, end, comma_end) in enumerate(members):
    if key in sets:
        present.add(key)
        edits.append((start, end, json.dumps(sets[key], ensure_ascii=False)))
    elif key in unsets:
        if comma_end is not None:
            a, b = key_start, comma_end
            while b < len(text) and text[b] in " \t":
                b += 1
            if b < len(text) and text[b] == "\n":
                b += 1
        else:
            a, b = key_start, end
            prev = plain[:key_start].rstrip()
            if prev.endswith(","):
                a = len(prev) - 1
        line_start = text.rfind("\n", 0, a) + 1
        if not text[line_start:a].strip() and (b == len(text) or text[b - 1] == "\n"):
            a = line_start
        removals.append((a, b))

removals.sort()
merged = []
for a, b in removals:
    if merged and a <= merged[-1][1]:
        merged[-1] = (merged[-1][0], max(merged[-1][1], b))
    else:
        merged.append((a, b))
edits += [(a, b, "") for a, b in merged]

missing = [f"\n  {json.dumps(k)}: {json.dumps(v, ensure_ascii=False)}" for k, v in sets.items() if k not in present]
if missing:
    edits.append((brace + 1, brace + 1, ",".join(missing) + ("," if root else "\n")))

updated = text
for start, end, replacement in sorted(edits, reverse=True):
    updated = updated[:start] + replacement + updated[end:]
if updated == original or (not original.strip() and not sets):
    sys.exit(0)

fd, tmp = tempfile.mkstemp(dir=os.path.dirname(real), prefix=".settings.json.")
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(updated)
    os.chmod(tmp, os.stat(real).st_mode & 0o7777)
    os.replace(tmp, real)
except BaseException:
    os.unlink(tmp)
    raise
PY
)

python3 -I -c "$settings_py" "$@"
