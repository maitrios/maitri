#!/bin/bash

# maitri:summary=Build and install an maitri package from a local checkout
# maitri:group=dev
# maitri:args=[package-name] [path-to-checkout]
# maitri:examples=maitri dev pkg-test | maitri dev pkg-test maitri-dev ~/dev/maitri

set -euo pipefail

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  cat <<USAGE
Usage: maitri dev pkg-test [package-name] [path-to-checkout]

Builds and installs an maitri package from a local maitri source
checkout. Use when changes need to land at fixed system paths (/etc/,
/usr/lib/systemd/, udev rule bodies, plymouth) that maitri-dev-link
can't shadow.

Defaults:
  packages          maitri-settings-dev maitri-dev
  path-to-checkout  ~/dev/maitri

Examples:
  maitri dev pkg-test
  maitri dev pkg-test maitri-settings-dev
  maitri dev pkg-test maitri-dev ~/dev/maitri

The pkgver of the built package is tagged 'dev.<short-sha>[.dirty]' so
'pacman -Q' makes it obvious where the installed version came from.

PKGBUILDs are read from \${MAITRI_PKGBUILDS_DIR:-~/dev/maitri-pkgs/pkgbuilds}/<package-name>/.
USAGE
  exit 0
fi

remove_pkgver_function() {
  local pkgbuild="$1"
  local tmp="$pkgbuild.tmp"

  awk '
    /^pkgver\(\)[[:space:]]*\{/ {
      in_pkgver = 1
      depth = 0
    }
    in_pkgver {
      line = $0
      opens = gsub(/\{/, "{", line)
      line = $0
      closes = gsub(/\}/, "}", line)
      depth += opens - closes
      if (depth <= 0) {
        in_pkgver = 0
      }
      next
    }
    { print }
  ' "$pkgbuild" >"$tmp"
  mv "$tmp" "$pkgbuild"
}

dev_package_name() {
  local pkg="$1"

  case "$pkg" in
    maitri | maitri-settings)
      printf '%s-dev\n' "$pkg"
      ;;
    *)
      printf '%s\n' "$pkg"
      ;;
  esac
}

if (( $# == 0 )); then
  PKGS=(maitri-settings-dev maitri-dev)
  CHECKOUT="$HOME/dev/maitri"
  MAKEPKG_ARGS=()
else
  PKGS=("$(dev_package_name "$1")")
  CHECKOUT="${2:-$HOME/dev/maitri}"
  MAKEPKG_ARGS=("${@:3}")
fi
PKGBUILDS_ROOT="${MAITRI_PKGBUILDS_DIR:-$HOME/dev/maitri-pkgs/pkgbuilds}"

# The release maitri pins maitri-settings to its own version, so the dev pair
# replace the release pair only together.
if (( ${#PKGS[@]} == 1 )); then
  case ${PKGS[0]} in
    maitri-settings-dev) partner=maitri-dev ;;
    maitri-dev) partner=maitri-settings-dev ;;
    *) partner="" ;;
  esac
  if [[ -n $partner ]] && ! pacman -Q "$partner" &>/dev/null; then
    echo "Adding $partner: the dev packages only replace the release ones together."
    PKGS+=("$partner")
  fi
fi

if [[ ! -d "$CHECKOUT" ]]; then
  echo "Error: checkout not found at $CHECKOUT" >&2
  exit 1
fi
for PKG in "${PKGS[@]}"; do
  PKGBUILD_DIR="$PKGBUILDS_ROOT/$PKG"
  if [[ ! -f "$PKGBUILD_DIR/PKGBUILD" ]]; then
    echo "Error: PKGBUILD not found at $PKGBUILD_DIR/PKGBUILD" >&2
    echo "       Pass a different package name as arg 1, or set MAITRI_PKGBUILDS_DIR." >&2
    exit 1
  fi
done

build_dir=$(mktemp -d -t maitri-dev-pkg-test.XXXXXX)
trap 'rm -rf "$build_dir"' EXIT

# pkgver=dev.<sha>[.dirty] so pacman -Q makes the source obvious.
short_sha=$(git -C "$CHECKOUT" rev-parse --short HEAD 2>/dev/null || echo "local")
dirty=""
if [[ -d "$CHECKOUT/.git" ]] && [[ -n "$(git -C "$CHECKOUT" status --porcelain)" ]]; then
  dirty=".dirty"
fi
new_pkgver="dev.${short_sha}${dirty}"

built_pkgs=()
for PKG in "${PKGS[@]}"; do
  PKGBUILD_DIR="$PKGBUILDS_ROOT/$PKG"
  package_build_dir="$build_dir/$PKG"
  mkdir -p "$package_build_dir"
  cp -a "$PKGBUILD_DIR/." "$package_build_dir/"

  remove_pkgver_function "$package_build_dir/PKGBUILD"
  sed -i "s/^pkgver=.*/pkgver=${new_pkgver}/" "$package_build_dir/PKGBUILD"

  echo "Building $PKG ${new_pkgver} from $CHECKOUT"
  echo "  build dir: $package_build_dir"
  echo "  PKGBUILD : $PKGBUILD_DIR/PKGBUILD"
  echo

  # The dev pair depend on each other (maitri-dev needs maitri-settings-dev), so
  # neither passes makepkg's dependency check before both are installed. They
  # only build with git and imagemagick; pacman resolves the rest below.
  (
    cd "$package_build_dir"
    MAITRI_SRC="$CHECKOUT" makepkg --nodeps --skipchecksums --noconfirm "${MAKEPKG_ARGS[@]}"
  )

  built_pkg=$(ls -t "$package_build_dir"/*.pkg.tar.* 2>/dev/null | grep -v '\.sig$' | head -1)
  if [[ -z $built_pkg ]]; then
    echo "Error: no built package found in $package_build_dir" >&2
    exit 1
  fi
  built_pkgs+=("$built_pkg")
done

# One transaction, so the dev pair replace the release pair together.
# --overwrite='*' because dev builds often meet files left behind by
# script-installed versions. --noconfirm answers no to removing the release
# package; --ask=4 flips only that answer.
sudo pacman -U --noconfirm --ask=4 --overwrite='*' "${built_pkgs[@]}"
