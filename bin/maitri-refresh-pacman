#!/bin/bash

# maitri:summary=Overwrite the package configuration for /etc/pacman with the maitri default of using the official Arch mirrors and the [maitri] repository for the current channel (or the one named), then update all packages.
# maitri:requires-sudo=true

channel="${1:-}"

if [[ -z $channel ]]; then
  channel=$(maitri-channel-current) || exit 1
  case "$channel" in
    stable | edge) ;;
    # A linked checkout uses the edge packages, just like channel-set dev.
    dev) channel=edge ;;
    unknown) channel=stable ;;
    *)
      echo "Cannot tell this machine's channel. No repository configuration changed." >&2
      exit 1
      ;;
  esac
fi

if [[ $channel != "stable" && $channel != "edge" ]]; then
  echo "Error: Invalid channel '$channel'. Must be one of: stable, edge"
  exit 1
fi

sudo cp -f /etc/pacman.conf /etc/pacman.conf.bak
sudo cp -f /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak

echo "Setting channel to $channel"
echo

sudo cp -f "$MAITRI_PATH/default/pacman/pacman-$channel.conf" /etc/pacman.conf
sudo cp -f "$MAITRI_PATH/default/pacman/mirrorlist-$channel" /etc/pacman.d/mirrorlist

# Allow user customization of /etc/pacman.conf before the upgrade runs
maitri-hook pre-refresh-pacman

# Reset all package DBs and then update
maitri-update-pacman -Syyuu --noconfirm
