#!/bin/bash

# maitri:summary=Pick one option from a menu
# maitri:group=menu
# maitri:name=select
# maitri:args=prompt [option...] [-- menu args...]
# maitri:examples=maitri menu select Format jpg png|maitri-menu-select Resolution 4k 1080p 720p -- --width 400

# An option may lead with an icon, as "<glyph><TAB><label>", and may trail a
# subtext shown under the label, as "<glyph><TAB><label><TAB><subtext>". The
# menu shows the glyph but never returns it. A plain option returns the label
# alone; an option with a subtext returns "<label><TAB><subtext>", so callers
# with same-named rows get the subtext back as the stable key.
#
# Rendered through `vicinae dmenu`, so every picker in maitri shares the
# launcher's look.

set -euo pipefail

if (( $# < 1 )); then
  echo "Usage: maitri-menu-select <prompt> [option...] [-- menu args...]" >&2
  exit 1
fi

prompt="$1"
shift

options=()
dmenu_args=()

while (( $# > 0 )); do
  if [[ $1 == "--" ]]; then
    shift
    while (( $# > 0 )); do
      case "$1" in
        --width)
          shift
          if (( $# == 0 )); then
            echo "maitri-menu-select: --width requires a value" >&2
            exit 1
          fi
          dmenu_args+=(-W "$1")
          ;;
        --height|--maxheight)
          arg="$1"
          shift
          if (( $# == 0 )); then
            echo "maitri-menu-select: $arg requires a value" >&2
            exit 1
          fi
          dmenu_args+=(-H "$1")
          ;;
      esac
      shift
    done
    break
  fi

  options+=("$1")
  shift
done

if (( ${#options[@]} == 0 )) && [[ ! -t 0 ]]; then
  mapfile -t options
fi

if (( ${#options[@]} == 0 )); then
  echo "Usage: maitri-menu-select <prompt> [option...] [-- menu args...]" >&2
  exit 1
fi

# Split every option into glyph / label / subtext, render one display line per
# option, and remember which display line maps back to which return value.
declare -A returns=()
display_lines=()
for option in "${options[@]}"; do
  IFS=$'\t' read -r first second third <<<"$option"
  if [[ $option == *$'\t'* ]]; then
    glyph="$first"
    label="$second"
    subtext="${third-}"
  else
    glyph=""
    label="$first"
    subtext=""
  fi

  display="$label"
  [[ -n $subtext ]] && display="$label  ·  $subtext"
  [[ -n $glyph ]] && display="$glyph  $display"

  if [[ -n $subtext ]]; then
    value="$label"$'\t'"$subtext"
  else
    value="$label"
  fi

  # First option wins on a duplicate display line, matching the shell menu.
  [[ -v returns[$display] ]] || returns[$display]="$value"
  display_lines+=("$display")
done

maitri-launch-vicinae --ensure-server

selection=$(printf '%s\n' "${display_lines[@]}" |
  vicinae dmenu --no-section -p "$prompt" "${dmenu_args[@]}" 2>/dev/null || true)

[[ -n $selection ]] || exit 1

if [[ -v returns[$selection] ]]; then
  printf '%s\n' "${returns[$selection]}"
else
  printf '%s\n' "$selection"
fi
