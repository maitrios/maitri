#!/bin/bash

# maitri:summary=Ensure default application launchers and mise wrappers are installed.

# Copy .desktop declarations
mkdir -p ~/.local/share/applications
cp "$MAITRI_PATH"/applications/*.desktop ~/.local/share/applications/

herdr_entry=~/.local/share/applications/herdr.desktop
if [[ ! -e $herdr_entry && ! -L $herdr_entry ]]; then
  cp "$MAITRI_PATH/default/applications/herdr.desktop" "$herdr_entry"
fi

if maitri-cmd-present alacritty; then
  cp "$MAITRI_PATH/default/alacritty/Alacritty.desktop" ~/.local/share/applications/
fi

if [[ -s ~/.local/state/maitri/icons/manifest ]]; then
  maitri-icons-set >/dev/null
fi

if [[ -f "$MAITRI_PATH/install/user/mise.sh" ]]; then
  bash "$MAITRI_PATH/install/user/mise.sh"
fi

update-desktop-database ~/.local/share/applications
