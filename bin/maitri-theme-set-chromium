#!/bin/bash

# maitri:summary=Color Helium, Chromium and Chrome profiles from the current maitri theme
# maitri:args=[--when-closed [<user data dir> <pid>]...]
# maitri:hidden=true

THEME_DIR="$HOME/.local/state/maitri/current/theme"
POLICY="$THEME_DIR/chromium-policy.json"
STATE_DIR="$HOME/.local/state/maitri"
WRITTEN_COLORS="$STATE_DIR/chromium-theme-colors"
APPLY_LOCK="$STATE_DIR/chromium-theme.lock"
WAITER_LOCK="$STATE_DIR/chromium-theme-waiter.lock"

BROWSERS=(
  "Helium|helium helium-browser|$HOME/.config/net.imput.helium $HOME/.config/helium"
  "Chromium|chromium|$HOME/.config/chromium"
  "Chrome|google-chrome-stable google-chrome|$HOME/.config/google-chrome"
)

# A profile keeps any theme its owner picked: an extension theme, a Customize
# Chrome color, grayscale, GTK or Qt, or the device colors. Only one still on
# the default theme, or on a color maitri wrote itself, is recolored. The
# light or dark setting is left alone; it follows the desktop by default.
apply_py=$(cat <<'PY'
import json, os, sys, tempfile

action, preferences_path, color, written_path = sys.argv[1:5]

try:
    with open(written_path, encoding="utf-8") as f:
        written = {line.strip().lower() for line in f if line.strip()}
except OSError:
    written = set()

try:
    with open(preferences_path, encoding="utf-8") as f:
        prefs = json.load(f)
except (OSError, ValueError):
    sys.exit(1)

def get(path, default=None):
    node = prefs
    for key in path.split("."):
        if not isinstance(node, dict) or key not in node:
            return default
        node = node[key]
    return node

def put(path, value):
    node = prefs
    keys = path.split(".")
    for key in keys[:-1]:
        if not isinstance(node.get(key), dict):
            node[key] = {}
        node = node[key]
    node[keys[-1]] = value

def to_hex(value):
    return "#%06x" % (value & 0xFFFFFF)

def to_skcolor(hex_color):
    value = 0xFF000000 | int(hex_color[1:], 16)
    return value - (1 << 32) if value >= (1 << 31) else value

theme_id = get("extensions.theme.id", "")
current = get("autogenerated.theme.color")

if theme_id in ("", "hkacjpbfdknhflllbcmjibkdeoafencn"):
    if get("browser.theme.is_grayscale2", False) or get("browser.theme.follows_system_colors", False):
        sys.exit(1)
    if get("extensions.theme.system_theme", 0) not in (0, None):
        sys.exit(1)
elif theme_id == "autogenerated_theme_id":
    if not isinstance(current, int) or to_hex(current) not in written:
        sys.exit(1)
    if current == to_skcolor(color):
        sys.exit(1)
else:
    sys.exit(1)

if action == "check":
    sys.exit(0)

put("extensions.theme.id", "autogenerated_theme_id")
put("autogenerated.theme.color", to_skcolor(color))

directory = os.path.dirname(preferences_path)
fd, tmp = tempfile.mkstemp(dir=directory, prefix=".Preferences.maitri-")
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(prefs, f, separators=(",", ":"))
    os.chmod(tmp, os.stat(preferences_path).st_mode & 0o777)
    if color not in written:
        with open(written_path, "a", encoding="utf-8") as f:
            f.write(color + "\n")
    os.replace(tmp, preferences_path)
except OSError:
    os.unlink(tmp)
    sys.exit(2)
PY
)

theme_color() {
  local color

  [[ -f $POLICY ]] || return 1
  color=$(jq -r '.BrowserThemeColor // empty' "$POLICY" 2>/dev/null)
  [[ $color =~ ^#[0-9A-Fa-f]{6}$ ]] || return 1
  printf '%s' "${color,,}"
}

# Prints "name<TAB>user data dir" for every installed browser with a profile.
installed_roots() {
  local entry name commands roots root cmd present

  for entry in "${BROWSERS[@]}"; do
    IFS='|' read -r name commands roots <<<"$entry"

    present=""
    for cmd in $commands; do
      maitri-cmd-present "$cmd" && present=1 && break
    done
    [[ -n $present ]] || continue

    for root in $roots; do
      [[ -f "$root/Local State" ]] && printf '%s\t%s\n' "$name" "$root"
    done
  done
}

# A running browser holds Preferences in memory and writes them back on exit.
# Its SingletonLock names the process, and a lock left behind by a crash names
# one that no longer exists. Prints that process, or "elsewhere" for a browser
# running on another host over a shared home.
root_holder() {
  local target host pid

  target=$(readlink "$1/SingletonLock" 2>/dev/null) || return 1
  host=${target%-*}
  pid=${target##*-}
  [[ $pid =~ ^[0-9]+$ ]] || return 1

  if [[ $host != "$(uname -n)" ]]; then
    echo elsewhere
  elif kill -0 "$pid" 2>/dev/null; then
    echo "$pid"
  else
    return 1
  fi
}

root_open() {
  root_holder "$1" >/dev/null
}

profiles() {
  local preferences

  for preferences in "$1"/*/Preferences; do
    [[ -f $preferences && ! -L $preferences ]] && printf '%s\n' "$preferences"
  done
}

root_needs_color() {
  local preferences

  while IFS= read -r preferences; do
    python3 -c "$apply_py" check "$preferences" "$1" "$WRITTEN_COLORS" && return 0
  done < <(profiles "$2")

  return 1
}

apply_root() {
  local root="$1"
  local color preferences

  mkdir -p "$STATE_DIR"
  (
    flock -w 10 8 || exit 0
    color=$(theme_color) || exit 0
    root_open "$root" && exit 0

    while IFS= read -r preferences; do
      python3 -c "$apply_py" apply "$preferences" "$color" "$WRITTEN_COLORS"
    done < <(profiles "$root")
  ) 8>"$APPLY_LOCK"
}

wait_until_closed() {
  local -A holders=()
  local name root color waiting pid

  while (( $# >= 2 )); do
    holders[$1]=$2
    shift 2
  done

  mkdir -p "$STATE_DIR"
  exec 9>"$WAITER_LOCK"
  flock -w 10 9 || exit 0

  while (( SECONDS < 86400 )); do
    color=$(theme_color) || exit 0
    waiting=0

    while IFS=$'\t' read -r name root; do
      root_needs_color "$color" "$root" || continue

      # Chromium removes its lock before its last write of Preferences, so a
      # browser seen open stays open until its process is gone.
      if pid=$(root_holder "$root"); then
        holders[$root]=$pid
        waiting=1
      elif [[ ${holders[$root]:-} =~ ^[0-9]+$ ]] && kill -0 "${holders[$root]}" 2>/dev/null; then
        waiting=1
      else
        unset "holders[$root]"
        apply_root "$root"
      fi
    done < <(installed_roots)

    (( waiting )) || exit 0
    sleep 2
  done
}

if [[ ${1:-} == "--when-closed" ]]; then
  shift
  wait_until_closed "$@"
  exit 0
fi

color=$(theme_color) || exit 0
open=()
holders=()

while IFS=$'\t' read -r name root; do
  root_needs_color "$color" "$root" || continue

  if pid=$(root_holder "$root"); then
    open+=("$name")
    holders+=("$root" "$pid")
  else
    apply_root "$root"
  fi
done < <(installed_roots)

(( ${#open[@]} > 0 )) || exit 0

for name in $(printf '%s\n' "${open[@]}" | sort -u); do
  echo "$name is open, so it picks up the new theme once it's closed and started again." >&2
done

setsid -f "$0" --when-closed "${holders[@]}" </dev/null >/dev/null 2>&1
