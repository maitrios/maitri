#!/bin/bash

# maitri:summary=Set fish's syntax and pager colours from the current maitri theme
# maitri:hidden=true

src="$HOME/.local/state/maitri/current/theme/fish.fish"
[[ -f $src ]] || exit 0
maitri-cmd-present fish || exit 0

if grep -q '{{' "$src"; then
  echo "Skipping fish colours: fish.fish has unresolved colors." >&2
  exit 0
fi

# fish.fish is never sourced, since a theme from a git repo can ship its own:
# each line has to be a colour assignment and only the values reach fish.
value='(#?[0-9A-Fa-f]{6}|normal|--(bold|italics|underline|reverse|dim)|--background=#?[0-9A-Fa-f]{6})'
specs=()
while read -r line; do
  [[ -z $line ]] && continue

  if [[ ! $line =~ ^set\ -U\ (fish_(pager_)?color_[a-z_]+)((\ $value)+)$ ]]; then
    echo "Skipping fish colours: fish.fish has a line that isn't a colour: $line" >&2
    exit 0
  fi

  specs+=("${BASH_REMATCH[1]}${BASH_REMATCH[3]}")
done <"$src"

(( ${#specs[@]} > 0 )) || exit 0

# Universal variables reach every running fish at once, and fish's own default
# theme only fills in colours that aren't set in any scope.
fish -c 'for spec in $argv; set -U (string split " " -- $spec); end' -- "${specs[@]}"

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/fish"
shopt -s nullglob
for config in "$config_dir/config.fish" "$config_dir"/conf.d/*.fish; do
  [[ -f $config ]] || continue
  if grep -qE '^[[:space:]]*set[[:space:]]+(-g|--global)[[:space:]]+fish_(pager_)?color_' "$config"; then
    echo "fish: $config sets colours globally, which hides the maitri colours; remove those lines to follow the theme." >&2
  fi
done
