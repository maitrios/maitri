#!/bin/bash

# maitri:summary=Set fish's syntax and pager colours from the current maitri theme
# maitri:hidden=true

src="$HOME/.local/state/maitri/current/theme/fish.fish"
[[ -f $src ]] || exit 0
maitri-cmd-present fish || exit 0

if grep -q '{{' "$src"; then
  echo "Skipping fish colours: fish.fish has unresolved colors." >&2
  exit 0
fi

# fish.fish is never sourced, since a theme from a git repo can ship its own:
# each line has to be a colour assignment and only the values reach fish.
value='(#?[0-9A-Fa-f]{6}|normal|--(bold|italics|underline|reverse|dim)|--background=#?[0-9A-Fa-f]{6})'
specs=()
while read -r line || [[ -n $line ]]; do
  [[ -z $line || $line == \#* ]] && continue

  if [[ ! $line =~ ^set\ -U\ (fish_(pager_)?color_[a-z_]+)((\ $value)+)$ ]]; then
    echo "Skipping fish colours: fish.fish has a line that isn't a colour: $line" >&2
    exit 0
  fi

  specs+=("${BASH_REMATCH[1]}${BASH_REMATCH[3]}")
done <"$src"

# Colours maitri's template sets that this theme leaves out are erased, so a
# shorter fish.fish doesn't keep the previous theme's.
names=" ${specs[*]%% *} "
erase=()
while read -r _ _ name _; do
  [[ $name == fish_*color_* && $names != *" $name "* ]] && erase+=("-e $name")
done <"$MAITRI_PATH/default/themed/fish.fish.tpl"

# Universal variables reach every fish that isn't shadowing them. fish 4.3+
# gives a shell that started before any were set its default theme as globals,
# so those keep their colours until they restart.
fish -c 'for spec in $argv; set -U (string split " " -- $spec); end' -- "${erase[@]}" "${specs[@]}"

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/fish"
shopt -s nullglob
for config in "$config_dir/config.fish" "$config_dir"/conf.d/*.fish; do
  [[ -f $config ]] || continue
  if awk '
    /^[[:space:]]*fish_config[[:space:]]+theme[[:space:]]+choose/ { found = 1 }
    match($0, /^[[:space:]]*set([[:space:]]+-[-a-zA-Z]+)*[[:space:]]+fish_(pager_)?color_/) {
      flags = substr($0, 1, RLENGTH)
      if (flags ~ /[[:space:]](-[a-zA-Z]*g[a-zA-Z]*|--global)[[:space:]]/ && flags !~ /[[:space:]](-[a-zA-Z]*q[a-zA-Z]*|--query)[[:space:]]/) found = 1
    }
    END { exit !found }
  ' "$config"; then
    echo "fish: $config sets colours globally, which hides the maitri colours; remove those lines to follow the theme." >&2
  fi
done
