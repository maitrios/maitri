#!/bin/bash

# maitri:summary=Print the active maitri dev-link git branch
# maitri:hidden=true

maitri_path=${MAITRI_PATH:-/usr/share/maitri}
maitri_path=${maitri_path%/}

[[ $maitri_path != "/usr/share/maitri" ]] || exit 1

branch=$(git -C "$maitri_path" branch --show-current 2>/dev/null || true)
if [[ -z $branch ]]; then
  hash=$(git -C "$maitri_path" rev-parse --short HEAD 2>/dev/null || true)
  [[ -n $hash ]] || exit 1
  branch="detached@$hash"
fi

echo "$branch"
