#!/bin/bash

# maitri:summary=Run a command while holding the maitri update lock
# maitri:args=<held|run> [command] [args...]
# maitri:hidden=true

set -e

lock_dir="${XDG_RUNTIME_DIR:-/tmp}"
lock_path="$lock_dir/maitri-update.lock"

lock_is_held() {
  local lock_fd_path=""

  [[ -n ${MAITRI_UPDATE_LOCK_FD:-} && -e /proc/$$/fd/$MAITRI_UPDATE_LOCK_FD ]] || return 1

  lock_fd_path=$(readlink -f "/proc/$$/fd/$MAITRI_UPDATE_LOCK_FD" 2>/dev/null || true)
  [[ $lock_fd_path == "$(readlink -m "$lock_path")" ]] &&
    flock -n "$MAITRI_UPDATE_LOCK_FD"
}

case "${1:-}" in
  held)
    lock_is_held
    ;;
  run)
    shift
    if (( $# == 0 )); then
      echo "Usage: maitri-update-lock run <command> [args...]" >&2
      exit 2
    fi

    mkdir -p "$lock_dir" 2>/dev/null || true
    exec {MAITRI_UPDATE_LOCK_FD}>"$lock_path"
    if ! flock -n "$MAITRI_UPDATE_LOCK_FD"; then
      echo "An maitri update is already running."
      exit 1
    fi

    export MAITRI_UPDATE_LOCK_FD
    exec "$@"
    ;;
  *)
    echo "Usage: maitri-update-lock <held|run> [command] [args...]" >&2
    exit 2
    ;;
esac
