#!/bin/bash

# maitri:summary=Open the Plymouth unlock screen switcher

preview_dir="${XDG_CACHE_HOME:-$HOME/.cache}/maitri/unlock-selector/previews"

rm -rf "$preview_dir"
mkdir -p "$preview_dir"

ln -s "$MAITRI_PATH/default/plymouth/preview-unlock.png" "$preview_dir/default.png"

maitri-plymouth-list | while read -r name; do
  ln -s "$(maitri-theme-dir "$name")/preview-unlock.png" "$preview_dir/$name.png" 2>/dev/null
done

current=$(maitri-plymouth-current)
selected=""
[[ -n $current && -e $preview_dir/$current.png ]] && selected="$preview_dir/$current.png"

exec maitri-menu-images --print-name --show-labels --selected "$selected" "$preview_dir"
