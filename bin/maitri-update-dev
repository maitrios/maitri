#!/bin/bash

# maitri:summary=Update the active maitri dev checkout

set -euo pipefail

[[ $MAITRI_PATH != "/usr/share/maitri" ]] || exit 0

if ! git -C "$MAITRI_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: MAITRI_PATH is not a git checkout: $MAITRI_PATH" >&2
  exit 1
fi

upstream=$(git -C "$MAITRI_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip maitri dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate maitri dev checkout\e[0m"
git -C "$MAITRI_PATH" pull --ff-only
