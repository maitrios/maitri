#!/bin/bash

# maitri:summary=Launch the default editor selected via maitri defaults.
# maitri:args=[--inline] <path>

default_editor="$HOME/.local/state/maitri/defaults/editor"

if [[ ${1:-} == "--inline" ]]; then
  inline=true
  shift
else
  inline=false
fi

if [[ -f $default_editor ]]; then
  read -r editor <"$default_editor"
else
  editor="code"
fi

# VS Code is the default; fall back to nvim when the chosen editor is missing.
maitri-cmd-present "$editor" || editor="nvim"

case "${editor##*/}" in
nvim | vim | nano | micro | hx | helix | fresh)
  if [[ $inline == "true" ]]; then
    exec "$editor" "$@"
  else
    exec maitri-launch-tui "$editor" "$@"
  fi
  ;;
*)
  exec setsid uwsm-app -- "$editor" "$@"
  ;;
esac
