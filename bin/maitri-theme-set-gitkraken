#!/bin/bash

# maitri:summary=Apply the current maitri theme to GitKraken
# maitri:hidden=true

src="$HOME/.local/state/maitri/current/theme/gitkraken.json"
themes_dir="$HOME/.gitkraken/themes"

maitri-cmd-present gitkraken || exit 0
[[ -f $src ]] || exit 0

# GitKraken compiles theme values as LESS, so only plain colours are taken.
if ! jq -e '
  (keys - ["meta", "themeValues"] == []) and
  (.meta == {name: "maitri", scheme: .meta.scheme}) and (.meta.scheme == "dark" or .meta.scheme == "light") and
  (.themeValues | keys - ["root", "toolbar", "tabsbar"] == []) and
  ([.themeValues[] | to_entries[]] | all(
    (.key | test("^\\.?[a-z][A-Za-z0-9_-]*$")) and
    (.value | type == "string" and test("^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|transparent|none)$"))
  ))
' "$src" >/dev/null 2>&1; then
  echo "Skipping GitKraken theme: gitkraken.json has a value maitri doesn't apply." >&2
  exit 0
fi

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/maitri-theme-set-gitkraken.lock"
flock 9

# GitKraken lists the themes in this folder under Preferences > UI
# Customization and retints live when the selected one changes.
mkdir -p "$themes_dir"
cmp -s "$src" "$themes_dir/maitri.jsonc" && exit 0
tmp=$(mktemp "$themes_dir/.maitri-theme.XXXXXX")
cp "$src" "$tmp"
mv "$tmp" "$themes_dir/maitri.jsonc"
