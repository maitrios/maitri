#!/bin/bash

# maitri:summary=Restore the launcher icons maitri-icons-set swapped
# maitri:args=[desktop-file...]
# maitri:examples=maitri icons restore | maitri icons restore code.desktop

set -e

state_dir="$HOME/.local/state/maitri/icons"
manifest="$state_dir/manifest"
originals_dir="$state_dir/originals"
copies="$state_dir/copies"
user_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
icon_theme_dir="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor"

kept=""
kept_copies=""
prune_copies() {
  local copy name

  [[ -f $copies ]] || return 0
  while IFS= read -r copy; do
    [[ -n $copy ]] || continue
    name="${copy##*/}"
    name="${name%.*}"
    if [[ -n $kept ]] && cut -f3 <<<"$kept" | grep -Fxq "$name"; then
      kept_copies+="$copy"$'\n'
    elif [[ -e $copy || -L $copy ]]; then
      rm -f "$copy"
      touch "$icon_theme_dir"
    fi
  done <"$copies"
}

if [[ ! -s $manifest ]]; then
  prune_copies
  rm -rf "$state_dir"
  echo "No swapped icons to restore"
  exit 0
fi

declare -A only=()
for id in "$@"; do
  [[ $id == *.desktop ]] || id="$id.desktop"
  if ! cut -f1 "$manifest" | grep -Fxq "$id"; then
    echo "No swapped icon for $id" >&2
  fi
  only[$id]=1
done

tmp=""
trap '[[ -z $tmp ]] || rm -f "$tmp"' EXIT

revert_icon() {
  local file="$1" icon="$2" key

  key="${icon##*/}"
  [[ $key =~ \.(png|svg)$ ]] && key="${key%.*}"
  key="${key#maitri-}"
  tmp="$(mktemp "$state_dir/write.XXXXXX")"
  ICON="Icon=$icon" KEY="Icon=$key" awk '$0 == ENVIRON["ICON"] { $0 = ENVIRON["KEY"] } { print }' "$file" >"$tmp"
  chmod --reference="$file" "$tmp"
  mv "$tmp" "$file"
  tmp=""
}

while IFS=$'\t' read -r id kind icon hash; do
  [[ -n $id ]] || continue

  if (( $# > 0 )) && [[ -z ${only[$id]-} ]]; then
    kept+="$id"$'\t'"$kind"$'\t'"$icon"$'\t'"$hash"$'\n'
    continue
  fi

  desktop_file="$user_dir/$id"
  original="$originals_dir/$id"

  if [[ -f $desktop_file ]] && grep -Fxq "Icon=$icon" "$desktop_file"; then
    unchanged=0
    [[ -z $hash || $(sha256sum <"$desktop_file" | cut -d' ' -f1) == "$hash" ]] && unchanged=1

    if (( unchanged )) && [[ $kind == "created" ]]; then
      rm "$desktop_file"
    elif (( unchanged )) && [[ -e $original || -L $original ]]; then
      mv "$original" "$desktop_file"
    else
      revert_icon "$desktop_file" "$icon"
    fi
    echo "Restored icon for $id"
  fi

  rm -f "$original"
done <"$manifest"

prune_copies

if [[ -n $kept ]]; then
  printf '%s' "$kept" >"$manifest"
  printf '%s' "$kept_copies" >"$copies"
else
  rm -rf "$state_dir"
fi

update-desktop-database "$user_dir" &>/dev/null || true
