#!/bin/bash

# maitri:summary=Prompt for text input from a menu
# maitri:group=menu
# maitri:name=input
# maitri:args=prompt [menu args...]
# maitri:examples=maitri menu input Reminder|maitri-menu-input "Reminder in minutes" --width 400

# `vicinae dmenu` only returns one of the lines it was given, so free text
# goes through the maitri Vicinae extension's menu-input command instead. The
# prompt and two tempfiles travel as the command's fallbackText; the extension
# writes the answer to selectionFile and touches doneFile (cancel touches only
# doneFile), the same handshake the Quickshell menu used.

set -euo pipefail

prompt="${1:-Input}"
if (( $# > 0 )); then
  shift
fi

menu_width=""

while (( $# > 0 )); do
  case "$1" in
    --width)
      shift
      if (( $# == 0 )); then
        echo "maitri-menu-input: --width requires a value" >&2
        exit 1
      fi
      menu_width="$1"
      ;;
  esac
  shift
done

selection_file=$(mktemp)
done_file=$(mktemp)
rm -f "$done_file"
trap 'rm -f "$selection_file" "$done_file"' EXIT

payload=$(jq -nc --arg prompt "$prompt" --arg selectionFile "$selection_file" --arg doneFile "$done_file" --arg width "$menu_width" '
  { prompt: $prompt, selectionFile: $selectionFile, doneFile: $doneFile }
  + (if $width == "" then {} else { width: ($width | tonumber) } end)')

maitri-launch-vicinae "vicinae://launch/@kindness-ai/maitri/menu-input?fallbackText=$(jq -rn --arg p "$payload" '$p | @uri')" >/dev/null

while [[ ! -e $done_file ]]; do
  sleep 0.05
done

if [[ -s $selection_file ]]; then
  cat "$selection_file"
else
  exit 1
fi
