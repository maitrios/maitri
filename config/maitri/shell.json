{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "maitri.clock",
    "layout": {
      "left": [
        {
          "id": "maitri.launcher"
        },
        {
          "id": "maitri.workspaces"
        }
      ],
      "center": [
        {
          "id": "maitri.indicators"
        },
        {
          "id": "maitri.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "maitri.keyboard-layout"
        },
        {
          "id": "maitri.weather"
        },
        {
          "id": "maitri.system-update"
        }
      ],
      "right": [
        {
          "id": "maitri.tray"
        },
        {
          "id": "maitri.agents"
        },
        {
          "id": "maitri.bluetooth"
        },
        {
          "id": "maitri.network"
        },
        {
          "id": "maitri.audio"
        },
        {
          "id": "maitri.monitor"
        },
        {
          "id": "maitri.power"
        }
      ]
    }
  },
  "plugins": [],
  "disabledPlugins": [
    "maitri.menu",
    "maitri.emojis",
    "maitri.clipboard"
  ]
}
