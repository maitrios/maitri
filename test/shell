#!/bin/bash

set -euo pipefail

# Some suites mount tmpfs over /home, /run and /var to isolate root-only code
# paths. Unprivileged runs get a user namespace for that; a root run (a CI
# container) would mount on the real host, so give it a private namespace too.
if (( EUID == 0 )) && [[ ${MAITRI_TEST_MOUNT_NAMESPACE:-0} != 1 ]] &&
  unshare --mount --propagation private true 2>/dev/null; then
  exec env MAITRI_TEST_MOUNT_NAMESPACE=1 unshare --mount --propagation private bash "$0" "$@"
fi

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
TEST_DIR="$ROOT/test/shell.d"

# The suites read $MAITRI_PATH and call maitri-* commands the way the
# installed runtime does. Point both at this checkout so the tests exercise the
# tree under test, not the copy a maitri machine has installed.
export MAITRI_PATH="$ROOT"
export PATH="$ROOT/bin:$PATH"

shopt -s nullglob
tests=()
for test in "$TEST_DIR"/*-test.sh; do
  [[ $(basename "$test") == "base-test.sh" ]] && continue
  tests+=("$test")
done
shopt -u nullglob

if (( ${#tests[@]} == 0 )); then
  echo "No shell tests found in $TEST_DIR" >&2
  exit 1
fi

# Keep going after a failing file. A test file exits at its first failed
# assertion, so aborting the run there too would hide every file after it --
# one packaging failure was masking 114 of 134 files.
output=$(mktemp)
trap 'rm -f "$output"' EXIT
failed=()
skipped=()
for test in "${tests[@]}"; do
  printf '==> %s\n' "${test#$ROOT/}"
  bash "$test" | tee "$output" || failed+=("${test#$ROOT/}")
  if grep -q '^ok - .* # SKIP$' "$output"; then
    skipped+=("${test#$ROOT/}")
  fi
done

if (( ${#skipped[@]} > 0 )); then
  printf '\nSkipped checks in %d of %d test files:\n' "${#skipped[@]}" "${#tests[@]}"
  printf '  %s\n' "${skipped[@]}"
fi

if (( ${#failed[@]} > 0 )); then
  printf '\n%d of %d test files failed:\n' "${#failed[@]}" "${#tests[@]}" >&2
  printf '  %s\n' "${failed[@]}" >&2
  exit 1
fi

if (( ${#skipped[@]} == 0 )); then
  printf '\nAll %d test files passed.\n' "${#tests[@]}"
else
  printf '\n%d test files completed without failures; %d had skipped checks.\n' "${#tests[@]}" "${#skipped[@]}"
fi
