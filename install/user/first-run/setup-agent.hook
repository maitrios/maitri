#!/bin/bash

set -e

# maitri ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(maitri-default-agent) ]] && maitri-done ensure agent-setup-invitation; then
  maitri-notification-send -u critical -g 󰚩 "Set your default agent" \
    "Let your favorite agent help with maitri." \
    --exec maitri menu summon setup.default.agent
fi
