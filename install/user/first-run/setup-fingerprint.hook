#!/bin/bash

set -e

# Only invite when there's a reader to use and it isn't set up yet (the lock
# PAM file is the last thing the setup writes on success).
if maitri-hw-fingerprint && [[ ! -f /etc/pam.d/maitri-lock-fingerprint ]] &&
  maitri-done ensure fingerprint-setup-invitation; then
  maitri-notification-send -u critical -g 󰈷 "Setup Fingerprint Reader" \
    "Enable sudo and unlocking with your fingerprint." \
    --exec maitri-launch-floating-terminal-with-presentation maitri-setup-security-fingerprint
fi
